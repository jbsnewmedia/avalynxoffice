{% extends 'base.html.twig' %}
{% block title %}{{ 'legal.admin.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {% do addAssetComposer('summernote-next/summernote-next/dist/summernote-next.min.css') %}
    {% do addAssetComposer('summernote-next/summernote-next/dist/summernote-next.min.js') %}
    {% if app.request.locale starts with 'de' %}
        {% do addAssetComposer('summernote-next/summernote-next/dist/lang/de-de.js') %}
    {% endif %}
    {% do addAssetComposer('app/assets/js/legal-editor.js') %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, showLanguageDropdown: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'legal/_admin_content.html.twig' %}
        </div>
    </main>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
{% endblock %}
