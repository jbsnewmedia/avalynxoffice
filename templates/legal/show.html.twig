{% extends 'base.html.twig' %}
{% block title %}{{ ('legal.' ~ page)|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block flashes %}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'legal/_nav.html.twig' with { active: page } %}
            {% include 'connector/_flashes.html.twig' %}

            <h1 class="h3 mb-4">{{ ('legal.' ~ page)|trans }}</h1>

            {% if content is not empty %}
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="legal-content">
                            {{ content|sanitize_html('legal') }}
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-body-secondary">{{ 'legal.placeholder'|trans }}</p>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
{% endblock %}
