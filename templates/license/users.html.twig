{% extends 'base.html.twig' %}
{% block title %}{{ 'license.users.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'admin/_nav.html.twig' with { active: 'users' } %}
            <h1 class="h3 mb-4">{{ 'license.users.title'|trans }}</h1>

            <div class="card shadow-sm">
                <div class="card-header bg-body-tertiary"><strong>{{ 'license.users.title'|trans }}</strong></div>
                <div class="card-body">
                    <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'profile.email'|trans }}</th>
                                <th>{{ 'license.users.roles'|trans }}</th>
                                <th>{{ 'license.users.state'|trans }}</th>
                                <th>{{ 'license.users.last_auth'|trans }}</th>
                                <th class="text-end">{{ 'mailbox.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for user in seatUsers %}
                            <tr class="{{ user.isActive() ? '' : 'table-secondary' }}">
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        <span class="badge bg-secondary-subtle text-body">{{ role|role_label }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    {% if user.isActive() %}
                                        <span class="badge bg-success-subtle text-body"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>{{ 'license.users.active'|trans }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="fa-solid fa-ban me-1" aria-hidden="true"></i>{{ 'license.users.inactive'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if user.lastAuthAt %}
                                        {{ user.lastAuthAt|date('Y-m-d H:i') }}
                                    {% else %}
                                        <span class="text-body-secondary">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('license_admin_toggle_role', {id: user.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_admin_' ~ user.id) }}">
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" {{ lastActiveAdminId == user.id or entitlement.isReadOnly ? 'disabled' }} title="{{ 'license.users.revoke_admin'|trans }}" aria-label="{{ 'license.users.revoke_admin'|trans }}">
                                                <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                                            </button>
                                        {% else %}
                                            <button type="submit" class="btn btn-sm btn-outline-primary" {{ entitlement.isReadOnly ? 'disabled' }} title="{{ 'license.users.grant_admin'|trans }}" aria-label="{{ 'license.users.grant_admin'|trans }}">
                                                <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                                            </button>
                                        {% endif %}
                                    </form>
                                    <form method="post" action="{{ path('license_admin_toggle_user', {id: user.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_active_' ~ user.id) }}">
                                        {% if user.isActive() %}
                                            <button type="submit" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'license.users.confirm_deactivate'|trans }}" title="{{ 'license.users.deactivate'|trans }}" aria-label="{{ 'license.users.deactivate'|trans }}" {{ lastActiveAdminId == user.id ? 'disabled' }}>
                                                <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
                                            </button>
                                        {% else %}
                                            <button type="submit" class="btn btn-sm btn-outline-success" {{ entitlement.isReadOnly ? 'disabled' }} title="{{ 'license.users.activate'|trans }}" aria-label="{{ 'license.users.activate'|trans }}">
                                                <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                                            </button>
                                        {% endif %}
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
{% block page_footer %}{% endblock %}
{% block javascripts %}
    {{ parent() }}
{% endblock %}
