{# Params: entitlement (AvalynxOffice\Licensing\Model\LicenseEntitlement) #}
<div class="card shadow-sm mt-4">
    <div class="card-header bg-body-tertiary"><strong>{{ 'license.recognized_licenses'|trans }}</strong></div>
    <div class="card-body">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>{{ 'license.key.license_id'|trans }}</th>
                    <th>{{ 'license.key.organization'|trans }}</th>
                    <th>{{ 'license.key.additional_seats'|trans }}</th>
                    <th>{{ 'license.key.expires_at'|trans }}</th>
                    <th>{{ 'license.key.source'|trans }}</th>
                    <th>{{ 'license.key.status'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% set sourceLabels = {'ENV': 'license.source.env', 'FILE': 'license.source.file', 'DATABASE': 'license.source.database'} %}
            {% set keyStatusStyle = {
                'valid': 'bg-success-subtle text-body',
                'expired': 'bg-secondary',
                'not_yet_valid': 'bg-secondary',
                'wrong_organization': 'bg-danger-subtle text-body',
                'installation_mismatch': 'bg-danger-subtle text-body',
                'invalid_signature': 'bg-danger-subtle text-body',
                'unknown_key_id': 'bg-danger-subtle text-body',
                'invalid_format': 'bg-danger-subtle text-body',
                'invalid_payload': 'bg-danger-subtle text-body',
                'duplicate': 'bg-secondary',
            } %}
            {% for diagnostic in entitlement.diagnostics %}
                <tr>
                    <td class="font-monospace small">{{ diagnostic.licenseId ?? '—' }}</td>
                    <td class="font-monospace small">{{ diagnostic.organizationId ?? '—' }}</td>
                    <td>{{ diagnostic.additionalSeats ?? '—' }}</td>
                    <td>{{ diagnostic.expiresAt ? diagnostic.expiresAt|date('Y-m-d') : '—' }}</td>
                    <td>{{ (sourceLabels[diagnostic.source.value] ?? diagnostic.source.value)|trans }}</td>
                    <td>
                        <span class="badge {{ keyStatusStyle[diagnostic.status.value] ?? 'bg-secondary' }}">{{ ('license.key_status.' ~ diagnostic.status.value)|trans }}</span>
                    </td>
                </tr>
            {% endfor %}
            {% for license in entitlement.validLicenses %}
                <tr>
                    <td class="font-monospace small">{{ license.licenseId }}</td>
                    <td class="font-monospace small">{{ license.organizationId }}</td>
                    <td>+{{ license.additionalSeats }}</td>
                    <td>{{ license.expiresAt|date('Y-m-d') }}</td>
                    <td>{{ (sourceLabels[license.source.value] ?? license.source.value)|trans }}</td>
                    <td><span class="badge bg-success-subtle text-body">{{ 'license.key_status.valid'|trans }}</span></td>
                </tr>
            {% endfor %}
            {% if entitlement.diagnostics|length == 0 and entitlement.validLicenses|length == 0 %}
                <tr>
                    <td colspan="6" class="text-body-secondary text-center py-4">{{ 'license.no_licenses'|trans }}</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
    </div>
</div>
