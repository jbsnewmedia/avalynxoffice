<div class="p-4 modal-form-ajax-success">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('app_settings') }}" class="btn btn-outline-secondary me-2 action-btn-modal" data-title="{{ 'settings.title'|trans }}" data-modal-size="modal-xl" data-dismiss-label="{{ 'common.close'|trans }}" aria-label="{{ 'common.back'|trans }}" title="{{ 'common.back'|trans }}">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <h4 class="m-0">{{ 'license.title'|trans }}</h4>
    </div>

    {% include 'license/_status.html.twig' %}

    {% if entitlement.isReadOnly %}
        <div class="alert alert-danger mt-4 mb-0" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>{{ 'license.warning.read_only'|trans }}
        </div>
    {% elseif entitlement.isOverLimit %}
        <div class="alert alert-warning mt-4 mb-0" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>{{ 'license.warning.grace'|trans }}
        </div>
    {% elseif 'COMMUNITY' === entitlement.status.value and entitlement.usedSeats >= entitlement.allowedSeats %}
        <div class="alert alert-info mt-4 mb-0" role="alert">
            <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>{{ 'license.info.community_limit'|trans }}
        </div>
    {% endif %}

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-body-tertiary"><strong>{{ 'license.users.title'|trans }}</strong></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'profile.email'|trans }}</th>
                        <th>{{ 'license.users.roles'|trans }}</th>
                        <th>{{ 'license.users.state'|trans }}</th>
                        <th class="text-end">{{ 'mailbox.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in seatUsers %}
                    <tr class="{{ user.isActive() ? '' : 'table-secondary' }}">
                        <td>{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                <span class="badge bg-secondary-subtle text-body">{{ role }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            {% if user.isActive() %}
                                <span class="badge bg-success-subtle text-body"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>{{ 'license.users.active'|trans }}</span>
                            {% else %}
                                <span class="badge bg-secondary"><i class="fa-solid fa-ban me-1" aria-hidden="true"></i>{{ 'license.users.inactive'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <form method="post" action="{{ path('license_admin_toggle_user', {id: user.id}) }}" class="d-inline modal-form-ajax">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_active_' ~ user.id) }}">
                                {% if user.isActive() %}
                                    <button type="button" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'license.users.confirm_deactivate'|trans }}" title="{{ 'license.users.deactivate'|trans }}" aria-label="{{ 'license.users.deactivate'|trans }}">
                                        <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
                                    </button>
                                {% else %}
                                    <button type="submit" class="btn btn-sm btn-outline-success" {{ entitlement.isReadOnly ? 'disabled' }} title="{{ 'license.users.activate'|trans }}" aria-label="{{ 'license.users.activate'|trans }}">
                                        <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                                    </button>
                                {% endif %}
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-body-tertiary"><strong>{{ 'license.keys.manage'|trans }}</strong></div>
        <div class="card-body">
            {% if not trustedKeysConfigured %}
                <div class="alert alert-warning" role="alert">
                    <i class="fa-solid fa-key me-2" aria-hidden="true"></i>{{ 'license.info.no_trusted_keys'|trans }}
                </div>
            {% endif %}
            <form method="post" action="{{ path('license_admin_add_keys') }}" class="modal-form-ajax">
                <input type="hidden" name="_token" value="{{ csrf_token('add_license_keys') }}">
                <label for="license_keys_input" class="form-label">{{ 'license.keys.add'|trans }}</label>
                <textarea class="form-control font-monospace" id="license_keys_input" name="license_keys" rows="4" placeholder="WOL1.…" aria-label="{{ 'license.keys.add'|trans }}"></textarea>
                <div class="form-text">{{ 'license.keys.help'|trans }}</div>
                <button type="submit" class="btn btn-primary mt-3">
                    <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>{{ 'license.keys.save'|trans }}
                </button>
            </form>
        </div>
    </div>

    {% if storedKeys|length > 0 %}
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-body-tertiary"><strong>{{ 'license.keys.stored'|trans }}</strong></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'license.keys.preview'|trans }}</th>
                            <th>{{ 'license.keys.added_at'|trans }}</th>
                            <th class="text-end">{{ 'mailbox.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for stored in storedKeys %}
                        <tr>
                            <td class="font-monospace small">{{ stored.licenseKey[:24] }}…</td>
                            <td>{{ stored.addedAt|date('Y-m-d H:i') }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('license_admin_delete_key', {id: stored.id}) }}" class="d-inline modal-form-ajax">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_license_key_' ~ stored.id) }}">
                                    <button type="button" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'license.keys.confirm_delete'|trans }}" title="{{ 'license.keys.delete'|trans }}" aria-label="{{ 'license.keys.delete'|trans }}">
                                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {% include 'license/_diagnostics.html.twig' %}
</div>
