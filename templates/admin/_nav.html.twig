{# Params:
    active (string) — currently active admin section: 'dashboard'|'users'|'password_resets'|'license'
#}
{% set adminNavItems = {
    'dashboard': {route: 'app_admin', icon: 'fa-gauge-high', label: 'admin.nav.dashboard'},
    'users': {route: 'license_admin_users', icon: 'fa-users', label: 'admin.nav.users'},
    'accounts': {route: 'account_index', icon: 'fa-envelope', label: 'admin.nav.accounts'},
    'connectors': {route: 'connector_index', icon: 'fa-plug', label: 'admin.nav.connectors'},
    'password_resets': {route: 'app_admin_password_resets', icon: 'fa-key', label: 'admin.nav.password_resets'},
    'legal': {route: 'app_settings_legal', icon: 'fa-file-contract', label: 'admin.nav.legal'},
    'license': {route: 'license_admin', icon: 'fa-scale-balanced', label: 'admin.nav.license'},
} %}
{% set adminNavCurrent = adminNavItems[active]|default(adminNavItems.dashboard) %}
<div class="dropdown mb-4">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="adminNavDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'admin.nav.switch'|trans }}" title="{{ 'admin.nav.switch'|trans }}">
        <i class="fa-solid {{ adminNavCurrent.icon }} me-2" aria-hidden="true"></i>{{ adminNavCurrent.label|trans }}
    </button>
    <ul class="dropdown-menu" aria-labelledby="adminNavDropdown">
        {% for key, item in adminNavItems %}
            <li>
                {% if key == active %}
                    <a class="dropdown-item active d-flex align-items-center" href="{{ path(item.route) }}" aria-current="true">
                        <i class="fa-solid {{ item.icon }} me-2" aria-hidden="true"></i>{{ item.label|trans }} ✓
                    </a>
                {% else %}
                    <a class="dropdown-item d-flex align-items-center" href="{{ path(item.route) }}">
                        <i class="fa-solid {{ item.icon }} me-2" aria-hidden="true"></i>{{ item.label|trans }}
                    </a>
                {% endif %}
            </li>
            {% if key == 'dashboard' %}
                <li><hr class="dropdown-divider" aria-hidden="true"></li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
