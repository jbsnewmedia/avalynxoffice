{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.password_resets.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'authenticated' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="container py-4">
    <h1 class="h3 mb-4">{{ 'admin.password_resets.title'|trans }}</h1>

    {% if flow is not null %}
        <div class="card border-success mb-4 shadow-sm">
            <div class="card-body">
                <h2 class="h5 text-success mb-3"><i class="fa-solid fa-key me-2"></i>{{ 'admin.password_resets.flow_started'|trans }}</h2>
                <p class="mb-3">{{ 'admin.password_resets.flow_help'|trans }}</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">{{ 'admin.password_resets.token'|trans }}</dt>
                    <dd class="col-sm-8"><code class="fs-5">{{ flow.token }}</code></dd>
                    <dt class="col-sm-4">{{ 'admin.password_resets.release_number'|trans }}</dt>
                    <dd class="col-sm-8"><code class="fs-5">{{ flow.number }}</code></dd>
                </dl>
            </div>
        </div>
    {% endif %}

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">{{ 'admin.password_resets.start_title'|trans }}</h2>
            <form method="post" action="{{ path('app_admin_password_resets_start') }}" class="row g-3 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_password_reset_start') }}">
                <div class="col-md-6">
                    <label for="adminResetEmail" class="form-label">{{ 'admin.password_resets.user_email'|trans }}</label>
                    <input type="email" class="form-control" id="adminResetEmail" name="email" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-play me-2"></i>{{ 'admin.password_resets.start'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">{{ 'admin.password_resets.open_requests'|trans }}</h2>
            {% if requests is empty %}
                <p class="text-body-secondary mb-0">{{ 'admin.password_resets.no_requests'|trans }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>{{ 'admin.password_resets.user_email'|trans }}</th>
                                <th>{{ 'admin.password_resets.status'|trans }}</th>
                                <th>{{ 'admin.password_resets.expires_at'|trans }}</th>
                                <th class="text-end">{{ 'admin.password_resets.action'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for request in requests %}
                                <tr>
                                    <td>{{ request.user.email }}</td>
                                    <td><span class="badge bg-secondary">{{ request.status }}</span></td>
                                    <td>{{ request.expiresAt|format_datetime }}</td>
                                    <td class="text-end">
                                        {% if request.status == 'claimed' %}
                                            <form method="post" action="{{ path('app_admin_password_resets_release', { id: request.id }) }}" class="d-flex gap-2 justify-content-end align-items-center">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_password_reset_release') }}">
                                                <input type="text" class="form-control form-control-sm" name="number" style="width: 90px;" placeholder="{{ 'admin.password_resets.number_placeholder'|trans }}" required />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="fa-solid fa-check me-1"></i>{{ 'admin.password_resets.release'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
