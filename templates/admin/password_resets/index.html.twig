{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.password_resets.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block flashes %}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'authenticated' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'admin/_nav.html.twig' with { active: 'password_resets' } %}
            {% include '_flashes.html.twig' %}
            <h1 class="h3 mb-4">{{ 'admin.password_resets.title'|trans }}</h1>

            {% if flow is not null %}
                <div class="card border-success mb-4 shadow-sm">
                    <div class="card-header"><i class="fa-solid fa-key me-2" aria-hidden="true"></i>{{ 'admin.password_resets.flow_started'|trans }}</div>
                    <div class="card-body">
                        <p class="mb-3">{{ 'admin.password_resets.flow_help'|trans }}</p>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">{{ 'admin.password_resets.token'|trans }}</dt>
                            <dd class="col-sm-8"><code class="fs-5">{{ flow.token }}</code></dd>
                            <dt class="col-sm-4">{{ 'admin.password_resets.release_number'|trans }}</dt>
                            <dd class="col-sm-8"><code class="fs-5">{{ flow.number }}</code></dd>
                        </dl>
                    </div>
                </div>
            {% endif %}

            {% set statusMeta = {
                'pending': { style: 'text-bg-warning', label: 'admin.password_resets.status_pending' },
                'claimed': { style: 'text-bg-info', label: 'admin.password_resets.status_claimed' },
                'released': { style: 'text-bg-success', label: 'admin.password_resets.status_released' },
                'completed': { style: 'text-bg-success', label: 'admin.password_resets.status_completed' },
                'expired': { style: 'text-bg-secondary', label: 'admin.password_resets.status_expired' },
                'invalidated': { style: 'text-bg-danger', label: 'admin.password_resets.status_invalidated' },
            } %}

            <div class="card shadow-sm mb-4">
                <div class="card-header"><i class="fa-solid fa-play me-2" aria-hidden="true"></i>{{ 'admin.password_resets.start_title'|trans }}</div>
                <div class="card-body">
                    <form id="admin-password-reset-start-form" method="post" action="{{ path('app_admin_password_resets_start') }}" novalidate data-avalynxform="1">
                        <div class="form-group">
                            <label for="adminResetEmail" class="form-label">{{ 'admin.password_resets.user_email'|trans }}</label>
                            <input type="email" class="form-control" id="adminResetEmail" name="email" autocomplete="email" required placeholder="{{ 'common.email_placeholder'|trans }}" />
                            <div class="invalid-feedback" aria-live="polite"></div>
                        </div>
                        <div class="text-end mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_password_reset_start') }}">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-play me-2"></i>{{ 'admin.password_resets.start'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header"><i class="fa-regular fa-clock me-2" aria-hidden="true"></i>{{ 'admin.password_resets.open_requests'|trans }}</div>
                <div class="card-body">
                    {% if requests is empty %}
                        <p class="text-body-secondary mb-0">{{ 'admin.password_resets.no_requests'|trans }}</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'admin.password_resets.user_email'|trans }}</th>
                                        <th>{{ 'admin.password_resets.status'|trans }}</th>
                                        <th>{{ 'admin.password_resets.expires_at'|trans }}</th>
                                        <th class="text-end">{{ 'admin.password_resets.action'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in requests %}
                                        {% set meta = statusMeta[request.status] ?? { style: 'text-bg-secondary', label: null } %}
                                        <tr>
                                            <td>{{ request.user.email|idn_to_utf8 }}</td>
                                            <td><span class="badge {{ meta.style }}">{{ meta.label ? meta.label|trans : request.status }}</span></td>
                                            <td>{{ request.expiresAt|user_datetime('short') }}</td>
                                            <td class="text-end">
                                                {% if request.status in ['pending', 'claimed'] %}
                                                    <form method="post" action="{{ path('app_admin_password_resets_release', { id: request.id }) }}" class="d-flex gap-2 justify-content-end align-items-center" novalidate data-avalynxform="1">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_password_reset_release_' ~ request.id) }}">
                                                        <input type="hidden" name="number" id="release-number-{{ request.id }}" value="">
                                                        <div class="invalid-feedback d-block w-auto" aria-live="polite"></div>
                                                        <button type="submit" class="btn btn-sm btn-success confirm-action"
                                                                data-confirm="{{ 'admin.password_resets.confirm_release'|trans }}"
                                                                data-confirm-input="number"
                                                                data-confirm-input-label="{{ 'admin.password_resets.number_placeholder'|trans }}"
                                                                title="{{ 'admin.password_resets.release'|trans }}" aria-label="{{ 'admin.password_resets.release'|trans }}">
                                                            <i class="fa-solid fa-check me-1" aria-hidden="true"></i>{{ 'admin.password_resets.release'|trans }}
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
