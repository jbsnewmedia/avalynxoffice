{% extends 'base.html.twig' %}
{% block title %}{{ 'license.users.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% do addAssetComposer('avalynx/avalynx-datatable/dist/css/avalynx-datatable.css') %}
    {% include '_assets.html.twig' with { mode: 'authenticated' } %}
    {{ parent() }}
{% endblock %}
{% block javascripts %}
    {% do addAssetComposer('avalynx/avalynx-datatable/dist/js/avalynx-datatable.js') %}
    {{ parent() }}
{% endblock %}
{% block flashes %}{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'admin/_nav.html.twig' with { active: 'users' } %}
            <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                <h1 class="h3 mb-0">{{ 'license.users.title'|trans }}</h1>
                <a href="{{ path('admin_users_new') }}" class="btn btn-primary action-btn-modal {{ readOnly ? 'disabled' }}" {{ readOnly ? 'aria-disabled="true"' }} data-title="{{ 'admin.users.new'|trans }}" data-modal-size="modal-lg">
                    <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>{{ 'admin.users.new'|trans }}
                </a>
            </div>

            {% include 'connector/_flashes.html.twig' %}

            <div class="card shadow-sm">
                <div class="card-body">
                    <div id="admin-users-datatable"
                        data-avalynxdatatable
                        data-api-url="{{ path('admin_users_data') }}"
                        data-per-page="10"
                        data-label-show="{{ 'admin.datatable.show'|trans }}"
                        data-label-entries="{{ 'admin.datatable.entries'|trans }}"
                        data-label-search="{{ 'admin.datatable.search'|trans }}"
                        data-label-previous="{{ 'admin.datatable.previous'|trans }}"
                        data-label-next="{{ 'admin.datatable.next'|trans }}"
                        data-label-showing="{{ 'admin.datatable.showing_entries'|trans }}"
                        data-label-showing-filtered="{{ 'admin.datatable.showing_filtered_entries'|trans }}"
                        aria-label="{{ 'license.users.title'|trans }}"
                        role="region"></div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
