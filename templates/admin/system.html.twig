{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.system.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block flashes %}{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'admin/_nav.html.twig' with { active: 'system' } %}
            <h1 class="h3 mb-4">{{ 'admin.system.title'|trans }}</h1>

            {% include '_flashes.html.twig' %}

            <div id="admin-system-status"
                 data-live-refresh="10000"
                 data-live-refresh-url="{{ path('app_admin_system_status') }}">
                {% include 'admin/_system_status.html.twig' %}
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-body-tertiary d-flex align-items-center gap-2">
                    <i class="fa-solid fa-sliders" aria-hidden="true"></i><strong>{{ 'admin.system.settings'|trans }}</strong>
                </div>
                <div class="card-body">
                    <div class="p-2">
                        {{ form_start(form, {'attr': {'id': 'sync-settings-form', 'data-avalynxform': '1', 'novalidate': 'novalidate'}}) }}
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        {{ form_label(form.intervalSeconds) }}
                                        {{ form_widget(form.intervalSeconds, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_help(form.intervalSeconds) }}
                                        <div class="invalid-feedback" aria-live="polite"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        {{ form_label(form.busyIntervalSeconds) }}
                                        {{ form_widget(form.busyIntervalSeconds, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_help(form.busyIntervalSeconds) }}
                                        <div class="invalid-feedback" aria-live="polite"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        {{ form_label(form.mailsLimit) }}
                                        {{ form_widget(form.mailsLimit, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_help(form.mailsLimit) }}
                                        <div class="invalid-feedback" aria-live="polite"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        {{ form_label(form.contactsLimit) }}
                                        {{ form_widget(form.contactsLimit, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_help(form.contactsLimit) }}
                                        <div class="invalid-feedback" aria-live="polite"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        {{ form_label(form.calendarLimit) }}
                                        {{ form_widget(form.calendarLimit, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_help(form.calendarLimit) }}
                                        <div class="invalid-feedback" aria-live="polite"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-3">
                                {{ form_widget(form.save) }}
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
