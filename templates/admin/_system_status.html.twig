<div class="card shadow-sm mb-4" data-system-status-card="environment">
    <div class="card-header bg-body-tertiary d-flex align-items-center gap-2">
        <i class="fa-solid fa-server" aria-hidden="true"></i><strong>{{ 'admin.system.environment'|trans }}</strong>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">{{ 'admin.system.runtime'|trans }}</dt>
            <dd class="col-sm-8">
                {% if runtime.docker %}
                    <span class="badge text-bg-info" data-runtime-mode="docker"><i class="fa-brands fa-docker me-1" aria-hidden="true"></i>{{ 'admin.system.runtime_docker'|trans }}</span>
                {% else %}
                    <span class="badge text-bg-secondary" data-runtime-mode="native">{{ 'admin.system.runtime_native'|trans }}</span>
                {% endif %}
            </dd>
            <dt class="col-sm-4">{{ 'admin.system.eas'|trans }}</dt>
            <dd class="col-sm-8">
                {% if runtime.eas.configured %}
                    {% if runtime.eas.available %}
                        <span class="badge text-bg-success" data-eas-state="available"><i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>{{ 'admin.system.eas_available'|trans }}</span>
                    {% else %}
                        <span class="badge text-bg-danger" data-eas-state="unavailable"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>{{ 'admin.system.eas_unavailable'|trans }}</span>
                    {% endif %}
                    {% if runtime.eas.latencyMs is not null %}
                        <span class="text-body-secondary small ms-2">{{ runtime.eas.latencyMs }} ms</span>
                    {% endif %}
                    <div class="text-body-secondary small text-break">{{ runtime.eas.url }}</div>
                {% else %}
                    <span class="badge text-bg-secondary" data-eas-state="not_configured">{{ 'admin.system.eas_not_configured'|trans }}</span>
                    <div class="form-text mb-0">{{ 'admin.system.eas_not_configured_help'|trans }}</div>
                {% endif %}
            </dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4" data-system-status-card="latest">
    <div class="card-header bg-body-tertiary d-flex align-items-center gap-2">
        <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i><strong>{{ 'admin.status.title'|trans }}</strong>
    </div>
    <div class="card-body">
        {% if lastSyncRun is null %}
            <p class="text-body-secondary mb-0">{{ 'admin.status.never'|trans }}</p>
        {% else %}
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                {% if lastSyncRun.status == 'running' %}
                    <span class="badge text-bg-info"><i class="fa-solid fa-spinner fa-spin me-1" aria-hidden="true"></i>{{ 'admin.status.running'|trans }}</span>
                {% elseif lastSyncRun.status == 'error' %}
                    <span class="badge text-bg-danger"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>{{ 'admin.status.error'|trans }}</span>
                {% else %}
                    <span class="badge text-bg-success"><i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>{{ 'admin.status.success'|trans }}</span>
                {% endif %}
                <span class="text-body-secondary small">{{ 'admin.status.trigger'|trans }}: {{ ('admin.status.trigger_' ~ lastSyncRun.trigger)|trans }}</span>
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-4">{{ 'admin.status.started'|trans }}</dt>
                <dd class="col-sm-8">{{ lastSyncRun.startedAt|user_datetime }}</dd>
                {% if lastSyncRun.finishedAt %}
                    <dt class="col-sm-4">{{ 'admin.status.finished'|trans }}</dt>
                    <dd class="col-sm-8">
                        {{ lastSyncRun.finishedAt|user_datetime }}
                        <span class="text-body-secondary small">({{ (lastSyncRun.finishedAt.getTimestamp() - lastSyncRun.startedAt.getTimestamp()) }}s)</span>
                    </dd>
                {% endif %}
                <dt class="col-sm-4">{{ 'admin.status.mails'|trans }}</dt>
                <dd class="col-sm-8">
                    {{ 'admin.status.mails_counts'|trans({
                        '%imported%': lastSyncRun.mailsImported,
                        '%skipped%': lastSyncRun.mailsSkipped,
                        '%errors%': lastSyncRun.mailsErrors,
                    }) }}
                </dd>
                <dt class="col-sm-4">{{ 'admin.status.contacts'|trans }}</dt>
                <dd class="col-sm-8">{{ lastSyncRun.contactsCount }}</dd>
                <dt class="col-sm-4">{{ 'admin.status.calendar'|trans }}</dt>
                <dd class="col-sm-8">{{ lastSyncRun.calendarCount }}</dd>
            </dl>
            {% if lastSyncRun.message %}
                <div class="alert alert-danger mb-0 mt-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>{{ lastSyncRun.message }}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>

{% if recentRuns|length > 0 %}
    <div class="card shadow-sm mb-4" data-system-status-card="recent">
        <div class="card-header bg-body-tertiary"><strong>{{ 'admin.status.recent'|trans }}</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'admin.status.started'|trans }}</th>
                            <th>{{ 'common.status'|trans }}</th>
                            <th>{{ 'admin.status.trigger'|trans }}</th>
                            <th>{{ 'admin.status.mails'|trans }}</th>
                            <th class="text-end">{{ 'admin.status.contacts'|trans }}</th>
                            <th class="text-end">{{ 'admin.status.calendar'|trans }}</th>
                            <th>{{ 'admin.status.message'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for run in recentRuns %}
                        <tr class="{{ run.status == 'error' ? 'table-danger' : '' }}">
                            <td>{{ run.startedAt|user_datetime }}</td>
                            <td>
                                {% if run.status == 'error' %}
                                    <span class="badge text-bg-danger">{{ 'admin.status.error'|trans }}</span>
                                {% elseif run.status == 'running' %}
                                    <span class="badge text-bg-info">{{ 'admin.status.running'|trans }}</span>
                                {% else %}
                                    <span class="badge text-bg-success">{{ 'admin.status.success'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ ('admin.status.trigger_' ~ run.trigger)|trans }}</td>
                            <td>{{ run.mailsImported }} / {{ run.mailsSkipped }} / {{ run.mailsErrors }}</td>
                            <td class="text-end">{{ run.contactsCount }}</td>
                            <td class="text-end">{{ run.calendarCount }}</td>
                            <td class="small text-body-secondary">{{ run.message }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endif %}

<div class="card shadow-sm mb-4" data-system-status-card="connectors">
    <div class="card-header bg-body-tertiary">
        <strong>{{ 'admin.system.connectors'|trans }}</strong>
        <span class="text-body-secondary small ms-2">{{ 'admin.system.connectors_hint'|trans }}</span>
    </div>
    <div class="card-body p-0">
        {% if connectors|length == 0 %}
            <p class="text-body-secondary mb-0 p-3">{{ 'admin.system.connectors_none'|trans }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'connector.name'|trans }}</th>
                            <th>{{ 'connector.domain'|trans }}</th>
                            <th>{{ 'admin.system.plugin'|trans }}</th>
                            <th>{{ 'connector.input'|trans }}</th>
                            <th>{{ 'connector.status_mails'|trans }}</th>
                            <th>{{ 'connector.status_contacts'|trans }}</th>
                            <th>{{ 'connector.status_calendar'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for entry in connectors %}
                        <tr>
                            <td>{{ entry.name }}</td>
                            <td>{{ entry.domain }}</td>
                            <td>
                                {% if entry.plugin %}
                                    <span class="badge text-bg-light border">{{ entry.plugin }}</span>
                                {% else %}
                                    <span class="text-body-secondary">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if entry.inputConfigured %}
                                    <span class="badge text-bg-success">{{ 'connector.configured_yes'|trans }}</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ 'connector.configured_no'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ entry.status.mails ?? '—' }}</td>
                            <td>{{ entry.status.contacts ?? '—' }}</td>
                            <td>{{ entry.status.calendar ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
