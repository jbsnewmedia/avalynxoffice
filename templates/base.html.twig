<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|replace({'_':'-'}) }}">
    <head>
        <meta charset="UTF-8">
        <script>
            (function() {
                let theme = localStorage.getItem('theme');
                if (theme !== 'light' && theme !== 'dark') {
                    theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', theme);
            })();
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Title!{% endblock %}</title>
        <link rel="manifest" href="/manifest.webmanifest">
        <meta name="theme-color" content="#ffffff">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="default">
        <link rel="icon" type="image/svg+xml" href="{{ path('app_assets_logo_svg') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ path('app_assets_logo_png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ path('app_assets_logo_png') }}">
        <link rel="apple-touch-icon" href="{{ path('app_assets_logo_png') }}">
        {% block stylesheets %}
            {{ renderAssetComposerStylesheets() }}
        {% endblock %}
        {% block javascripts %}
            {{ renderAssetComposerJavascripts() }}
        {% endblock %}
    </head>
    <body>
        {% set flashMessages = app.flashes %}
        {% if flashMessages|length > 0 %}
            <div class="container-fluid px-4 pt-3">
                {% for label, messages in flashMessages %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message|trans }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'common.close'|trans }}"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
        {% block body %}{% endblock %}
        {% block page_footer %}{% if app.user %}
            <footer class="py-3 border-top bg-body-tertiary">
                <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-2 px-4">
                    <span class="text-body-secondary small">© {{ "now"|date("Y") }} JBS New Media GmbH · {{ 'app.title'|trans }}</span>
                    <ul class="nav small">
                        <li class="nav-item"><a class="nav-link text-body-secondary" href="{{ path('app_license') }}" aria-label="{{ 'license.menu'|trans }}">{{ 'license.footer_link'|trans }}</a></li>
                    </ul>
                </div>
            </footer>
        {% endif %}{% endblock %}
        <div class="modal fade" id="actionModal" tabindex="-1" aria-labelledby="actionModalLabel" aria-hidden="true" data-form-load-error="{{ 'js.form_load_error'|trans }}" data-default-dismiss-label="{{ 'common.cancel'|trans }}">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header text-bg-primary">
                        <h5 class="modal-title" id="actionModalLabel">...</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'common.close'|trans }}"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="d-flex justify-content-center p-5 action-modal-loader">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">{{ 'common.loading'|trans }}</span>
                            </div>
                        </div>
                        <div class="action-modal-content"></div>
                    </div>
                    <div class="modal-footer bg-body-tertiary d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary action-modal-dismiss" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button>
                        <div class="modal-form-buttons-target d-flex gap-2">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true" data-default-confirm="{{ 'common.confirm_question'|trans }}">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header text-bg-danger">
                        <h5 class="modal-title" id="confirmModalLabel">{{ 'common.confirmation'|trans }}</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'common.close'|trans }}"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="confirm-modal-text mb-0">...</p>
                    </div>
                    <div class="modal-footer bg-body-tertiary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button>
                        <button type="button" class="btn btn-danger confirm-modal-button">{{ 'common.confirm'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
