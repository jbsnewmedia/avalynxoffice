<div>
    <h6 class="mb-1">{{ 'mailbox.structure_title'|trans }}</h6>
    <p class="text-body-secondary mb-3">{{ 'mailbox.structure_description'|trans }}</p>

    {% if items|length > 0 %}
        <div class="settings-mailbox-structure">
            {% for mailbox in items %}
                <div class="settings-mailbox-card">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                        <div>
                            <div class="fw-semibold">{{ mailbox.name }}</div>
                            <div class="text-body-secondary small">{{ mailbox.email }}</div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <div class="settings-mailbox-list-title">{{ 'connector.list'|trans }}</div>
                            <ul class="settings-mailbox-list">
                                {% for connector in mailbox.connectors %}
                                    <li>
                                        <span class="fw-medium">{{ connector.name }}</span>
                                        <span class="text-body-secondary small d-block">{{ connector.email }}</span>
                                    </li>
                                {% else %}
                                    <li class="text-body-secondary">{{ 'connector.none'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="settings-mailbox-list-title">{{ 'mailbox.aliases'|trans }}</div>
                            <ul class="settings-mailbox-list">
                                {% for address in mailbox.addresses %}
                                    <li>{{ address.email }}</li>
                                {% else %}
                                    <li class="text-body-secondary">{{ 'mailbox.no_addresses'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="settings-mailbox-list-title">{{ 'mailbox.folders'|trans }}</div>
                            <ul class="settings-mailbox-list">
                                {% for folder in mailbox.folders %}
                                    <li>
                                        <span>{{ folder.name }}</span>
                                        {% if folder.functions is empty %}
                                            <span class="badge bg-secondary-subtle text-body ms-1">{{ 'folder.function.none'|trans }}</span>
                                        {% else %}
                                            {% for function in folder.functions %}
                                                <span class="badge bg-secondary-subtle text-body ms-1">{{ ('folder.function.' ~ function)|trans }}</span>
                                            {% endfor %}
                                        {% endif %}
                                    </li>
                                {% else %}
                                    <li class="text-body-secondary">{{ 'folder.none'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-body-secondary small">{{ 'mailbox.none'|trans }}</div>
    {% endif %}
</div>
