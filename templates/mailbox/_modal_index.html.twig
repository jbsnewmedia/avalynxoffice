<div class="p-4 modal-form-ajax-success">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('app_settings') }}" class="btn btn-outline-secondary me-2 action-btn-modal" data-title="{{ 'settings.title'|trans }}" data-modal-size="modal-xl" data-dismiss-label="{{ 'common.close'|trans }}" aria-label="{{ 'common.back'|trans }}" title="{{ 'common.back'|trans }}">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <h4 class="m-0">{{ 'mailbox.title'|trans }}</h4>
        <div class="ms-auto d-flex gap-2">
            <a href="{{ path('mailbox_new') }}" class="btn btn-primary action-btn-modal" data-title="{{ 'mailbox.new'|trans }}" data-modal-size="modal-xl">
                <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>{{ 'mailbox.new'|trans }}
            </a>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'mailbox.name'|trans }}</th>
                        <th>{{ 'mailbox.email'|trans }}</th>
                        <th>{{ 'mailbox.aliases'|trans }}</th>
                        <th>{{ 'mailbox.folders'|trans }}</th>
                        <th>{{ 'mailbox.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for m in items %}
                    <tr>
                        <td>{{ m.name }}</td>
                        <td>{{ m.email }}</td>
                        <td>
                            {% if m.addresses|length > 0 %}
                                <div class="d-flex flex-wrap gap-1">
                                    {% for address in m.addresses %}
                                        <span class="badge bg-secondary-subtle text-body">{{ address.email }}</span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-body-secondary small">{{ 'mailbox.no_addresses'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if m.folders|length > 0 %}
                                <div class="d-flex flex-wrap gap-1">
                                    {% for folder in m.folders %}
                                        <span class="badge bg-light text-body border">
                                            {{ folder.name }}
                                            {% if folder.functions is empty %}
                                                <span class="badge bg-secondary-subtle text-body ms-1">{{ 'folder.function.none'|trans }}</span>
                                            {% else %}
                                                {% for function in folder.functions %}
                                                    <span class="badge bg-secondary-subtle text-body ms-1">{{ ('folder.function.' ~ function)|trans }}</span>
                                                {% endfor %}
                                            {% endif %}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-body-secondary small">{{ 'folder.none'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="text-nowrap">
                            <a href="{{ path('mailbox_edit', {id: m.id}) }}" class="btn btn-sm btn-primary action-btn-modal" data-title="{{ 'mailbox.edit'|trans }}" data-modal-size="modal-xl" title="{{ 'mailbox.edit'|trans }}" aria-label="{{ 'mailbox.edit'|trans }}">
                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ path('mailbox_delete', {id: m.id}) }}" class="d-inline modal-form-ajax">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_mailbox_' ~ m.id) }}">
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'mailbox.confirm_delete'|trans }}" title="{{ 'email.delete'|trans }}" aria-label="{{ 'email.delete'|trans }}">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-body-secondary text-center py-4">{{ 'mailbox.none'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
