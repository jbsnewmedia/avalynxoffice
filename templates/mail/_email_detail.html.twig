<div class="bg-warning-subtle text-warning-emphasis small px-3 py-2 border-bottom">
    <i class="fa-solid fa-puzzle-piece me-1" aria-hidden="true"></i> {{ 'mail.core_view_banner'|trans }}
</div>
<div class="sticky-top bg-body border-bottom shadow-sm">
    {% if activeAccountId|default(null) == 'all' %}
        <div class="account-tag bg-body-tertiary text-body-secondary small px-3 py-1 border-bottom" style="font-size: 0.75rem;">
            <i class="fa-solid fa-inbox me-1 small"></i> {{ email.account.name }}
        </div>
    {% endif %}
    <div class="p-3 email-action-bar d-flex justify-content-between align-items-center">
        <div class="btn-group email-actions" data-overflow-group="actions">
            {% set emailActionViews = mail_email_action_views(email) %}
            {% for actionView in emailActionViews %}
                {% include actionView.template with actionView.context only %}
            {% endfor %}
            <button type="button" class="btn btn-primary dropdown-toggle overflow-more d-none" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'email.more_actions'|trans }}" title="{{ 'email.more_actions'|trans }}">
                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" data-overflow-menu="actions" aria-label="{{ 'email.more_actions'|trans }}">
            </ul>
        </div>
    </div>
</div>
{% set senderLink = null %}
{% set toLinks = [] %}
{% set ccLinks = [] %}
{% set bccLinks = [] %}
{% set replyToLinks = [] %}
{% for link in email.emailAddresses %}
    {% if link.type.value == 'sender' %}
        {% set senderLink = link %}
    {% elseif link.type.value == 'recipient' %}
        {% set toLinks = toLinks|merge([link]) %}
    {% elseif link.type.value == 'cc' %}
        {% set ccLinks = ccLinks|merge([link]) %}
    {% elseif link.type.value == 'bcc' %}
        {% set bccLinks = bccLinks|merge([link]) %}
    {% elseif link.type.value == 'reply_to' %}
        {% set replyToLinks = replyToLinks|merge([link]) %}
    {% endif %}
{% endfor %}
{% set senderName = senderLink ? (senderLink.address.name ?: senderLink.address.email) : ('common.unknown'|trans) %}
{% set senderEmail = senderLink ? senderLink.address.email : '' %}
{% set nameParts = senderName|split(' ')|filter(part => part is not empty) %}
{% set senderInitials = nameParts|length >= 2 ? (nameParts[0]|slice(0, 1) ~ nameParts[1]|slice(0, 1)) : senderName|slice(0, 2) %}
{% set effDate = email.sentAt ?: email.receivedAt %}
{% set dateFull = effDate ? (effDate|user_datetime('short') ~ ' ' ~ ('common.oclock'|trans)) : ('common.unknown'|trans) %}
{% set dateIsToday = effDate and (effDate|user_datetime('date') == 'now'|user_datetime('date')) %}
{% set dateDisplay = dateIsToday ? (('common.today'|trans) ~ ', ' ~ (effDate|user_datetime('time') ~ ' ' ~ ('common.oclock'|trans))) : dateFull %}
{% set statusChip = {icon: 'fa-inbox', label: 'email.received'|trans, class: 'bg-success-subtle text-success-emphasis'} %}
{% if email.isOutgoing %}
    {% if email.isSent %}
        {% set statusChip = {icon: 'fa-paper-plane', label: 'email.sent'|trans, class: 'bg-primary-subtle text-primary-emphasis'} %}
    {% elseif email.isDraft %}
        {% set statusChip = {icon: 'fa-file-pen', label: 'email.draft'|trans, class: 'bg-secondary-subtle text-secondary-emphasis'} %}
    {% elseif email.scheduledAt and email.scheduledAt > date() %}
        {% set statusChip = {icon: 'fa-calendar-check', label: 'email.scheduled'|trans({'%date%': email.scheduledAt|user_datetime('short')}), class: 'bg-info-subtle text-info-emphasis'} %}
    {% else %}
        {% set statusChip = {icon: 'fa-clock', label: 'email.not_sent'|trans, class: 'bg-warning-subtle text-warning-emphasis'} %}
    {% endif %}
{% endif %}
<article class="card border-0 rounded-0 shadow-none mb-0">
    <header class="border-bottom px-3 px-md-4 pt-3 pb-3">
        <div class="d-flex align-items-start justify-content-between gap-2 gap-md-3 flex-wrap">
            <h2 class="email-detail-subject mb-0 text-break min-w-0" title="{{ email.subject }}">{{ email.subject ?: ('email.no_subject'|trans) }}</h2>
            <div class="d-flex align-items-center gap-2 flex-wrap flex-shrink-0">
                <span class="badge rounded-pill fw-semibold {{ statusChip.class }}">
                    <i class="fa-solid {{ statusChip.icon }} me-1" aria-hidden="true"></i>{{ statusChip.label }}
                </span>
                {% if email.isFavorite %}
                    <span class="badge rounded-pill fw-semibold bg-warning-subtle text-warning-emphasis" title="{{ 'email.favorite'|trans }}" aria-label="{{ 'email.favorite'|trans }}">
                        <i class="fa-solid fa-star me-1" aria-hidden="true"></i>{{ 'email.favorite'|trans }}
                    </span>
                {% endif %}
                {% if email.isImportant %}
                    <span class="badge rounded-pill fw-semibold bg-danger-subtle text-danger-emphasis" title="{{ 'email.important'|trans }}" aria-label="{{ 'email.important'|trans }}">
                        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>{{ 'email.important'|trans }}
                    </span>
                {% endif %}
                {% if email.hasEncodingIssues %}
                    <span class="badge rounded-pill fw-semibold bg-warning-subtle text-warning-emphasis" title="{{ 'email.encoding_corrected_tooltip'|trans }}" aria-label="{{ 'email.encoding_issues'|trans }}">
                        <i class="fa-solid fa-font me-1" aria-hidden="true"></i>{{ 'email.encoding_issues'|trans }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 gap-md-3 mt-3">
            <span class="avatar-gradient rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="--avatar-hue: {{ avatar_hue(senderEmail != '' ? senderEmail : senderName) }}; width: 44px; height: 44px; font-size: .875rem;" aria-hidden="true">{{ senderInitials|upper }}</span>
            <div class="flex-grow-1 min-w-0">
                <div class="text-truncate">
                    <span class="fw-semibold" title="{{ senderName }}">{{ senderName }}</span>
                    {% if senderEmail != '' and senderEmail != senderName %}
                        <span class="text-body-secondary small" title="{{ senderEmail }}">&lt;{{ senderEmail }}&gt;</span>
                    {% endif %}
                </div>
                <div class="d-flex gap-1 small text-body-secondary min-w-0">
                    <span class="flex-shrink-0">{{ 'email.to_label'|trans }}</span>
                    <div class="min-w-0">
                        {% for link in toLinks %}
                            {% set displayName = link.address.name ?: link.address.email %}
                            <div class="text-truncate" title="{{ displayName }}{% if link.address.email and link.address.email != displayName %} &lt;{{ link.address.email }}&gt;{% endif %}">{{ displayName }}{% if link.address.email and link.address.email != displayName %} &lt;{{ link.address.email }}&gt;{% endif %}</div>
                        {% else %}
                            <span>–</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% if effDate %}
                <div class="text-body-secondary small text-nowrap flex-shrink-0 d-none d-sm-block" title="{{ 'email.date_label'|trans({'%date%': dateFull}) }}" aria-label="{{ 'email.date_label'|trans({'%date%': dateFull}) }}">{{ dateDisplay }}</div>
            {% endif %}
            <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none rounded-circle p-2 email-detail-toggle flex-shrink-0"
                    data-bs-toggle="collapse"
                    data-bs-target="#email-meta-{{ email.id }}"
                    aria-expanded="false"
                    aria-controls="email-meta-{{ email.id }}"
                    title="{{ 'email.details_toggle'|trans }}" aria-label="{{ 'email.details_toggle'|trans }}">
                <i class="fa-solid fa-chevron-down chevron" aria-hidden="true"></i>
            </button>
        </div>
        <div id="email-meta-{{ email.id }}" class="collapse">
            <div class="email-meta-panel mt-3 p-3 bg-body-tertiary rounded-4 small">
                <div class="email-meta-grid">
                    <span class="email-meta-label">{{ 'email.from'|trans }}</span>
                    <span class="email-meta-value">{{ senderName }}{% if senderEmail != '' %} &lt;{{ senderEmail }}&gt;{% endif %}</span>
                    <span class="email-meta-label">{{ 'email.to'|trans }}</span>
                    <span class="email-meta-value">
                        {% if toLinks|length > 0 %}
                            {% for link in toLinks %}
                                {{ link.address.name ?: link.address.email }} &lt;{{ link.address.email }}&gt;{{ not loop.last ? ', ' : '' }}
                            {% endfor %}
                        {% else %}
                            <span class="text-body-secondary">–</span>
                        {% endif %}
                    </span>
                    {% if ccLinks|length > 0 %}
                        <span class="email-meta-label">{{ 'email.cc'|trans }}</span>
                        <span class="email-meta-value">
                            {% for link in ccLinks %}
                                {{ link.address.name ?: link.address.email }} &lt;{{ link.address.email }}&gt;{{ not loop.last ? ', ' : '' }}
                            {% endfor %}
                        </span>
                    {% endif %}
                    {% if bccLinks|length > 0 %}
                        <span class="email-meta-label">{{ 'email.bcc'|trans }}</span>
                        <span class="email-meta-value">
                            {% for link in bccLinks %}
                                {{ link.address.name ?: link.address.email }} &lt;{{ link.address.email }}&gt;{{ not loop.last ? ', ' : '' }}
                            {% endfor %}
                        </span>
                    {% endif %}
                    {% if replyToLinks|length > 0 %}
                        <span class="email-meta-label">{{ 'email.reply_to'|trans }}</span>
                        <span class="email-meta-value">
                            {% for link in replyToLinks %}
                                {{ link.address.name ?: link.address.email }} &lt;{{ link.address.email }}&gt;{{ not loop.last ? ', ' : '' }}
                            {% endfor %}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>
    <div class="card-body p-0">
        <div class="email-body-wrapper">
            {% set htmlBody = null %}
            {% set textBody = null %}
            {% for bl in email.emailBodies %}
                {% if bl.contentType.value == 'html' %}
                    {% set htmlBody = bl.body.content %}
                {% elseif bl.contentType.value == 'text' %}
                    {% set textBody = bl.body.content %}
                {% endif %}
            {% endfor %}
{% if htmlBody %}
            {% set srcdocHtml = '<!DOCTYPE html><html><head><meta charset="utf-8"><base target="_blank"><style>body{margin:0;padding:16px;word-wrap:break-word;color:#212529;background:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;}img{max-width:100%;height:auto;}a{color:#0d6efd;}table{max-width:100%;}</style></head><body>' ~ (htmlBody|email_inline_images(email)) ~ '</body></html>' %}
            <iframe class="email-html-frame"
                    srcdoc="{{ srcdocHtml|e('html_attr') }}"
                    sandbox="allow-popups"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    title="{{ 'email.content_title'|trans }}"></iframe>
        {% elseif textBody %}
            <pre class="mb-0 px-3 px-md-4 py-3" style="white-space: pre-wrap;">{{ textBody }}</pre>
        {% else %}
            <div class="text-body-secondary p-3 p-md-4">{{ 'email.no_content'|trans }}</div>
        {% endif %}
        </div>
    </div>
    {% set attCount = email.emailAttachments|length %}
    {% if attCount > 0 %}
        <footer class="border-top px-3 px-md-4 py-3">
            <h6 class="mb-2 text-body-secondary small text-uppercase" style="letter-spacing: .04em;">
                <i class="fa-solid fa-paperclip me-1" aria-hidden="true"></i>{{ 'email.attachments'|trans }} ({{ attCount }})
            </h6>
            <div class="d-flex flex-wrap gap-2">
                {% for l in email.emailAttachments %}
                    {% set a = l.attachment %}
                    <div class="email-attachment-chip d-inline-flex align-items-center gap-2 bg-body-tertiary rounded-3 ps-3 pe-1 py-1">
                        <i class="fa-regular {{ file_icon(a.mimeType ?? null, a.name ?? null) }} {{ file_icon_color(a.mimeType ?? null, a.name ?? null)|default('text-body-secondary') }} fs-4" aria-hidden="true"></i>
                        <span class="d-flex flex-column justify-content-center lh-sm min-w-0">
                            <span class="fw-medium text-truncate" style="max-width: 16rem;" title="{{ a.name }}">{{ a.name }}</span>
                            <span class="text-body-secondary" style="font-size: .75rem;">{{ a.size|bytes_to_human }}</span>
                        </span>
                        <a class="btn btn-sm btn-link text-body-secondary text-decoration-none p-2 rounded-circle flex-shrink-0"
                           href="{{ path('mail_email_attachment_download', {emailId: email.id, attachmentId: a.id}) }}"
                           title="{{ 'email.download'|trans }}"
                           aria-label="{{ 'email.download'|trans }}: {{ a.name }}">
                            <i class="fa-solid fa-download" aria-hidden="true"></i>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </footer>
    {% endif %}
</article>
