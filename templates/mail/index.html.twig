{% extends 'base.html.twig' %}
{% block javascripts %}
    {{ parent() }}
    <script id="i18n-mail" type="application/json">{{
        {
            loading_email: 'js.loading_email'|trans,
            load_more: 'js.load_more'|trans,
            email_load_error: 'js.email_load_error'|trans,
            no_results: 'js.no_results'|trans,
            already_in_folder: 'js.already_in_folder'|trans,
            unexpected_response: 'js.unexpected_response'|trans,
            move_failed: 'js.move_failed'|trans,
            moved_to_folder: 'js.moved_to_folder'|trans({'%name%': '__NAME__'}),
            read_label: 'js.read_label'|trans,
            unread_label: 'js.unread_label'|trans,
            folder_unread_aria: 'folder.unread_emails_count'|trans({'%count%': '__COUNT__'})
        }|json_encode(constant('JSON_HEX_TAG'))|raw
    }}</script>
{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block title %}{{ 'nav.mails'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block body %}
{% include '_navbar.html.twig' with { showMailToggles: true, activeModule: 'mail' } %}
<div class="offcanvas offcanvas-start" tabindex="-1" id="accountOffcanvas" aria-labelledby="accountOffcanvasLabel" role="dialog" aria-modal="true">
    <div class="offcanvas-header text-bg-primary">
        <h5 class="offcanvas-title" id="accountOffcanvasLabel">{{ 'offcanvas.accounts_and_folders'|trans }}</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="{{ 'common.close'|trans }}"></button>
    </div>
    <div class="offcanvas-body p-0">
        <aside class="bg-body">
            {% include 'mail/_accounts.html.twig' with { accounts: accounts, activeAccount: activeAccount } %}
            <div id="folders-container">
                {% include 'mail/_folders.html.twig' with { folders: folders, activeFolder: activeFolder, activeAccount: activeAccount, folderEmailCounts: folderEmailCounts, allMails: allMails } %}
            </div>
        </aside>
    </div>
</div>
<div class="offcanvas offcanvas-start" tabindex="-1" id="emailListOffcanvas" aria-labelledby="emailListOffcanvasLabel" role="dialog" aria-modal="true">
    <div class="offcanvas-header text-bg-primary">
        <h5 class="offcanvas-title" id="emailListOffcanvasLabel">{{ 'offcanvas.emails'|trans }}</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="{{ 'common.close'|trans }}"></button>
    </div>
    <div class="offcanvas-body p-0">
        <section class="bg-body">
            {% include 'mail/_email_list.html.twig' with { emails: emails, activeEmail: activeEmail, activeAccount: activeAccount, activeFolder: activeFolder, allMails: allMails } %}
        </section>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <aside class="col-xxl-2 d-none d-xxl-block mail-body-height overflow-auto bg-body shadow-sm p-0 border-end">
            {% include 'mail/_accounts.html.twig' with { accounts: accounts, activeAccount: activeAccount } %}
            {% include 'mail/_folders.html.twig' with { folders: folders, activeFolder: activeFolder, activeAccount: activeAccount, folderEmailCounts: folderEmailCounts, allMails: allMails } %}
        </aside>
        <section class="col-xxl-3 d-none d-xxl-block mail-body-height overflow-auto p-0 bg-body border-end">
            {% include 'mail/_email_list.html.twig' with { emails: emails, activeEmail: activeEmail, activeAccount: activeAccount, activeFolder: activeFolder, allMails: allMails } %}
        </section>
        <main class="col-xxl-7 col-12 mail-body-height overflow-auto bg-body p-0">
            <div id="email-detail">
                {% if activeEmail %}
                    {% include emailDetailTemplate|default('mail/_email_detail.html.twig') with { email: activeEmail, activeAccountId: activeAccount ? activeAccount.id : 'all' } %}
                {% else %}
                    <div class="p-5 text-center text-body-secondary">{{ 'emails.none_selected'|trans }}</div>
                {% endif %}
            </div>
        </main>
    </div>
</div>
{% endblock %}
