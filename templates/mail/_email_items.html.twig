{% for mail in emails %}
    {% set senderName = null %}
    {% for link in mail.emailAddresses %}
        {% if link.type.value == 'sender' %}
            {% set senderName = link.address.name ?: link.address.email %}
        {% endif %}
    {% endfor %}
    {% set attCount = mail.emailAttachments|length %}
    {% set isOutgoing = mail.isOutgoing %}
    {% set effDate = mail.sentAt ?: mail.receivedAt %}
    {% set senderDisplay = senderName ?: ('common.unknown'|trans) %}
    <article class="email-item border-bottom {{ activeEmail and activeEmail.id == mail.id ? 'email-active' : '' }} {{ mail.isRead ? '' : 'email-unread' }}" data-email="{{ mail.id }}" tabindex="0" role="button" aria-selected="{{ activeEmail and activeEmail.id == mail.id ? 'true' : 'false' }}" aria-label="{{ 'email.item_aria'|trans({'%sender%': senderDisplay, '%subject%': mail.subject}) }}" draggable="true">
        {% if (activeAccount is not defined or not activeAccount) %}
            <div class="account-tag bg-body-tertiary text-body-secondary small px-3 py-1 border-bottom" style="font-size: 0.75rem;">
                <i class="fa-solid fa-inbox me-1 small"></i> {{ mail.account.name }}
            </div>
        {% endif %}
        <div class="email-item-content px-3 pb-2 {{ (activeAccount is not defined or not activeAccount) ? 'pt-2' : 'pt-3' }}">
            <div class="email-item-sender {{ mail.isRead ? '' : 'fw-bold' }} text-truncate">
                {{ senderDisplay }}
            </div>
            <div class="email-subject mb-1 {{ mail.isRead ? '' : 'fw-semibold' }}">{{ mail.subject }}</div>
            <div class="text-body-secondary small text-truncate mb-2">{{ mail.previewBody }}</div>
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="important-indicator {{ mail.isImportant ? '' : 'd-none' }}" title="{{ 'email.important'|trans }}" aria-label="{{ 'email.important'|trans }}">
                        <i class="fa-solid fa-triangle-exclamation text-danger" aria-hidden="true"></i>
                    </span>
                    <span class="encoding-indicator {{ mail.hasEncodingIssues ? '' : 'd-none' }}" title="{{ 'email.encoding_issues'|trans }}" aria-label="{{ 'email.encoding_issues'|trans }}">
                        <i class="fa-solid fa-font text-warning-emphasis" aria-hidden="true"></i>
                    </span>
                    <span class="favorite-indicator {{ mail.isFavorite ? '' : 'd-none' }}" title="{{ 'email.favorite'|trans }}" aria-label="{{ 'email.favorite'|trans }}">
                        <i class="fa-solid fa-star text-warning" aria-hidden="true"></i>
                    </span>
                    {% if attCount > 0 %}
                        <small class="text-body-secondary" title="{{ 'email.attachments'|trans }}" aria-label="{{ 'email.attachments_count'|trans({'%count%': attCount}) }}">
                            <i class="fa-solid fa-paperclip me-1" aria-hidden="true"></i>{{ attCount }}
                        </small>
                    {% endif %}
                    {% if isOutgoing %}
                        {% if mail.sentAt %}
                            <i class="fa-solid fa-paper-plane text-primary" title="{{ 'email.sent'|trans }}" aria-label="{{ 'email.sent'|trans }}" aria-hidden="false"></i>
                        {% else %}
                            <i class="fa-solid fa-clock text-warning" title="{{ 'email.not_sent'|trans }}" aria-label="{{ 'email.not_sent'|trans }}" aria-hidden="false"></i>
                        {% endif %}
                    {% else %}
                        <i class="fa-solid fa-inbox text-success" title="{{ 'email.received'|trans }}" aria-label="{{ 'email.received'|trans }}" aria-hidden="false"></i>
                    {% endif %}
                    {% if not isOutgoing %}
                        <button type="button" class="btn btn-sm btn-link text-body-secondary p-0 toggle-read" data-email="{{ mail.id }}" data-read="{{ mail.isRead ? '0' : '1' }}" {{ license_manager.isReadOnly ? 'disabled aria-disabled="true"' }} title="{{ license_manager.isReadOnly ? ('license.read_only_action'|trans) : (mail.isRead ? ('email.mark_unread'|trans) : ('email.mark_read'|trans)) }}" aria-label="{{ mail.isRead ? ('email.mark_unread'|trans) : ('email.mark_read'|trans) }}">
                            <i class="fa-solid {{ mail.isRead ? 'fa-envelope' : 'fa-envelope-open' }}" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                </div>
                <small class="text-body-secondary text-nowrap" aria-label="{{ 'email.date_label'|trans({'%date%': effDate ? (effDate|user_datetime('short') ~ ' ' ~ ('common.oclock'|trans)) : ('common.unknown'|trans)}) }}">{{ effDate ? (effDate|user_datetime('short') ~ ' ' ~ ('common.oclock'|trans)) : '' }}</small>
            </div>
        </div>
    </article>
{% endfor %}
