<div class="p-3">
    <h6 class="text-uppercase text-body-secondary fw-bold small mb-2">{{ 'mail.folders'|trans }}</h6>
    <div class="list-group list-group-flush">
        {% for folder in folders %}
            {% set fid = folder.id ~ '' %}
            {% set cnt = folderEmailCounts[fid] ?? 0 %}
            <a href="{{ path('mail_folder', {mailboxId: activeMailbox ? activeMailbox.id : 'all', folderId: folder.id}) }}"
               class="list-group-item list-group-item-action d-flex align-items-center folder-drop-target {{ activeFolder and activeFolder.id == folder.id ? 'active' : '' }}"
               data-folder-id="{{ folder.id }}" data-folder-name="{{ folder.name }}"
               aria-label="{{ 'folder.open'|trans({'%name%': folder.name}) }}">
                <i class="fa-solid fa-folder me-2" aria-hidden="true"></i>
                <span>{{ folder.name }}</span>
                <span class="badge bg-primary rounded-pill ms-auto folder-unread-badge" data-folder-id="{{ fid }}" aria-label="{{ 'folder.unread_emails_count'|trans({'%count%': cnt}) }}">{{ cnt }}</span>
            </a>
        {% else %}
            <div class="list-group-item text-body-secondary">{{ 'folder.none'|trans }}</div>
        {% endfor %}
    </div>
</div>
