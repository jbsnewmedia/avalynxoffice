<div class="d-flex justify-content-end mb-3">
    <a href="{{ path('connector_new') }}" class="btn btn-primary" aria-label="{{ 'connector.new'|trans }}">
        <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>{{ 'connector.new'|trans }}
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'connector.name'|trans }}</th>
                        <th>{{ 'connector.domain'|trans }}</th>
                        <th>{{ 'connector.default_account'|trans }}</th>
                        <th>{{ 'connector.input'|trans }}</th>
                        <th>{{ 'connector.output'|trans }}</th>
                        <th>{{ 'common.status'|trans }}</th>
                        <th>{{ 'connector.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for connector in items %}
                    {% set status = pluginRegistry.getStatus(connector) %}
                    <tr>
                        <td><div class="fw-medium">{{ connector.name }}</div></td>
                        <td>{{ connector.domain }}</td>
                        <td>
                            {% if connector.defaultAccount %}
                                <div>{{ connector.defaultAccount.name }}</div>
                                <div class="small text-body-secondary">{{ connector.defaultAccount.email }}</div>
                            {% else %}
                                <span class="text-body-secondary small">{{ 'connector.no_default_account'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if pluginRegistry.isInputConfigured(connector) %}
                                <span class="badge text-bg-success">{{ 'connector.configured_yes'|trans }}</span>
                            {% else %}
                                <span class="badge text-bg-secondary">{{ 'connector.configured_no'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if pluginRegistry.isOutputConfigured(connector) %}
                                <span class="badge text-bg-success">{{ 'connector.configured_yes'|trans }}</span>
                            {% else %}
                                <span class="badge text-bg-secondary">{{ 'connector.configured_no'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="small">
                            <div>{{ 'connector.status_mails'|trans }}: {{ status.mails ?? '—' }}</div>
                            <div>{{ 'connector.status_contacts'|trans }}: {{ status.contacts ?? '—' }}</div>
                            <div>{{ 'connector.status_calendar'|trans }}: {{ status.calendar ?? '—' }}</div>
                        </td>
                        <td class="text-nowrap">
                            <a href="{{ path('connector_settings', {id: connector.id}) }}" class="btn btn-sm btn-primary" title="{{ 'connector.settings'|trans }}" aria-label="{{ 'connector.settings'|trans }}">
                                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-body-secondary text-center py-4">{{ 'connector.none'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
