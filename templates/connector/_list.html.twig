<div class="d-flex justify-content-end mb-3">
    <a href="{{ path('connector_new') }}" class="btn btn-primary" aria-label="{{ 'connector.new'|trans }}">
        <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>{{ 'connector.new'|trans }}
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'connector.name'|trans }}</th>
                        <th>{{ 'connector.domain'|trans }}</th>
                        <th>{{ 'connector.default_account'|trans }}</th>
                        <th>{{ 'connector.aliases'|trans }}</th>
                        <th>{{ 'connector.pop3'|trans }}</th>
                        <th>{{ 'connector.smtp_optional'|trans }}</th>
                        <th>{{ 'connector.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for connector in items %}
                    <tr>
                        <td><div class="fw-medium">{{ connector.name }}</div></td>
                        <td>{{ connector.domain }}</td>
                        <td>
                            {% if connector.defaultAccount %}
                                <div>{{ connector.defaultAccount.name }}</div>
                                <div class="small text-body-secondary">{{ connector.defaultAccount.email }}</div>
                            {% else %}
                                <span class="text-body-secondary small">{{ 'connector.no_default_account'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if connector.aliases|length > 0 %}
                                {% for alias in connector.aliases|slice(0, 4) %}
                                    <div class="small">{{ alias.localPart }}@{{ connector.domain }}</div>
                                {% endfor %}
                                {% if connector.aliases|length > 4 %}
                                    <div class="small text-body-secondary">+{{ connector.aliases|length - 4 }}</div>
                                {% endif %}
                            {% else %}
                                <span class="text-body-secondary small">—</span>
                            {% endif %}
                        </td>
                        <td>
                            <div>{{ connector.pop3Host ?: '—' }}</div>
                            <div class="small text-body-secondary">{{ connector.pop3Username ?: '—' }}</div>
                        </td>
                        <td>
                            <div>{{ connector.smtpHost ?: '—' }}</div>
                            <div class="small text-body-secondary">{{ connector.smtpUsername ?: '—' }}</div>
                        </td>
                        <td class="text-nowrap">
                            <a href="{{ path('connector_edit', {id: connector.id}) }}" class="btn btn-sm btn-primary" title="{{ 'connector.edit'|trans }}" aria-label="{{ 'connector.edit'|trans }}">
                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ path('connector_delete', {id: connector.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_connector_' ~ connector.id) }}">
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'connector.confirm_delete'|trans }}" title="{{ 'email.delete'|trans }}" aria-label="{{ 'email.delete'|trans }}">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-body-secondary text-center py-4">{{ 'connector.none'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    </div>
