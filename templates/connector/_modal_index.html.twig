<div class="p-4">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('app_settings') }}" class="btn btn-outline-secondary me-2" aria-label="{{ 'common.back'|trans }}" title="{{ 'common.back'|trans }}">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <h4 class="m-0">{{ 'connector.title'|trans }}</h4>
        <a href="{{ path('connector_new') }}" class="btn btn-primary ms-auto">
            <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>{{ 'connector.new'|trans }}
        </a>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'mailbox.name'|trans }}</th>
                        <th>{{ 'mailbox.email'|trans }}</th>
                        <th>{{ 'connector.mailbox'|trans }}</th>
                        <th>{{ 'mailbox.pop3'|trans }}</th>
                        <th>{{ 'mailbox.smtp_optional'|trans }}</th>
                        <th>{{ 'mailbox.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for connector in items %}
                    <tr>
                        <td>
                            <div class="fw-medium">{{ connector.name }}</div>
                            {% if connector.isPrimary %}
                                <div class="small text-body-secondary">{{ 'connector.primary'|trans }}</div>
                            {% endif %}
                        </td>
                        <td>{{ connector.email }}</td>
                        <td>
                            {% if connector.mailbox %}
                                <div>{{ connector.mailbox.name }}</div>
                                <div class="small text-body-secondary">{{ connector.mailbox.email }}</div>
                            {% else %}
                                <span class="text-body-secondary small">{{ 'mailbox.no_mailbox'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <div>{{ connector.pop3Host ?: '—' }}</div>
                            <div class="small text-body-secondary">{{ connector.pop3Username ?: '—' }}</div>
                        </td>
                        <td>
                            <div>{{ connector.smtpHost ?: '—' }}</div>
                            <div class="small text-body-secondary">{{ connector.smtpUsername ?: '—' }}</div>
                        </td>
                        <td class="text-nowrap">
                            <a href="{{ path('connector_edit', {id: connector.id}) }}" class="btn btn-sm btn-primary" title="{{ 'connector.edit'|trans }}" aria-label="{{ 'connector.edit'|trans }}">
                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ path('connector_delete', {id: connector.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_connector_' ~ connector.id) }}">
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'connector.confirm_delete'|trans }}" title="{{ 'email.delete'|trans }}" aria-label="{{ 'email.delete'|trans }}">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-body-secondary text-center py-4">{{ 'connector.none'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
