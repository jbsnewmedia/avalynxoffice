{{ form_start(form, {'attr': {'id': 'connector-form', 'data-avalynxform': '1', 'novalidate': 'novalidate'}}) }}
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">{{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-6">{{ form_row(form.domain, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-12">{{ form_row(form.defaultAccount, {'attr': {'class': 'form-select'}}) }}</div>
                <div class="col-12"><hr class="my-1"></div>
                <div class="col-12"><h6 class="mb-0">{{ 'connector.pop3'|trans }}</h6></div>
                <div class="col-md-4">{{ form_row(form.pop3Host, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-2">{{ form_row(form.pop3Port, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-3">{{ form_row(form.pop3Username, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-3">{{ form_row(form.pop3Password, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-4">{{ form_row(form.pop3Security, {'attr': {'class': 'form-select'}}) }}</div>
                <div class="col-md-8 d-flex align-items-end">{{ form_row(form.pop3DeleteAfterFetch, {'attr': {'class': 'form-check-input'}}) }}</div>
                <div class="col-12"><hr class="my-1"></div>
                <div class="col-12"><h6 class="mb-0">{{ 'connector.smtp_optional'|trans }}</h6></div>
                <div class="col-md-4">{{ form_row(form.smtpHost, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-2">{{ form_row(form.smtpPort, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-3">{{ form_row(form.smtpUsername, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-3">{{ form_row(form.smtpPassword, {'attr': {'class': 'form-control'}}) }}</div>
                <div class="col-md-4">{{ form_row(form.smtpSecurity, {'attr': {'class': 'form-select'}}) }}</div>
            </div>
        </div>
    </div>
    <div class="mt-3 d-flex justify-content-end">
        {{ form_widget(form.save) }}
    </div>
{{ form_end(form) }}
