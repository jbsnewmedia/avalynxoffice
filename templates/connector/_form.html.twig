{{ form_start(form, {'attr': {'id': 'connector-form', 'data-avalynxform': '1', 'novalidate': 'novalidate'}}) }}
    <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}</div>
        <div class="col-md-6">{{ form_row(form.domain, {'attr': {'class': 'form-control'}}) }}</div>
        <div class="col-md-6">{{ form_row(form.plugin, {'attr': {'class': 'form-select'}}) }}</div>
        <div class="col-md-6">{{ form_row(form.defaultAccount, {'attr': {'class': 'form-select'}}) }}</div>
    </div>
    <div class="mt-3 d-flex justify-content-end">
        {{ form_widget(form.save) }}
    </div>
{{ form_end(form) }}
