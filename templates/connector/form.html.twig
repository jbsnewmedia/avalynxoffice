{% extends 'base.html.twig' %}
{% block title %}{{ 'connector.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'admin/_nav.html.twig' with { active: 'connectors' } %}
            <h1 class="h3 mb-4">{{ title }}</h1>
            {% include 'connector/_modal_form.html.twig' %}
        </div>
    </main>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
{% endblock %}
