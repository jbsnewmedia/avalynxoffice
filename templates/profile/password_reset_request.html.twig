{% extends 'base.html.twig' %}
{% block title %}{{ 'password.reset.request_title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'guest' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
{% set code = code|default(null) %}
{% set sent = sent|default(false) %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, showLanguageDropdown: true } %}
    <section class="py-5 flex-grow-1 d-flex align-items-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                    <div class="card shadow mx-auto">
                        <div class="card-body p-4 p-md-5">
                            {% if code is not null %}
                                <h1 class="h4 mb-1">{{ 'password.reset.code_created_title'|trans }}</h1>
                                <div class="alert alert-success mt-3 mb-4" role="status">{{ 'password.reset.code_created_help'|trans }}</div>
                                <dl class="row mb-4">
                                    <dt class="col-sm-5">{{ 'password.reset.flow_token'|trans }}</dt>
                                    <dd class="col-sm-7"><code class="fs-5">{{ code.token }}</code></dd>
                                    <dt class="col-sm-5">{{ 'password.reset.flow_number'|trans }}</dt>
                                    <dd class="col-sm-7"><code class="fs-5">{{ code.number }}</code></dd>
                                </dl>
                                <a class="btn btn-primary w-100" href="{{ path('app_user_password_reset_flow', {token: code.token}) }}">
                                    <i class="fa-solid fa-key me-2" aria-hidden="true"></i>{{ 'password.reset.flow_open'|trans }}
                                </a>
                                <p class="text-center mt-4 mb-0">
                                    <a href="{{ path('app_login') }}" class="small">{{ 'password.reset.back_to_login'|trans }}</a>
                                </p>
                            {% elseif sent %}
                                <h1 class="h4 mb-1">{{ 'password.reset.sent_title'|trans }}</h1>
                                <div class="alert alert-success mt-3 mb-4" role="status">{{ 'password.reset.link_sent'|trans }}</div>
                                <a class="btn btn-primary w-100" href="{{ path('app_login') }}">
                                    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>{{ 'password.reset.back_to_login'|trans }}
                                </a>
                            {% else %}
                                <h1 class="h4 mb-1">{{ 'password.reset.request_title'|trans }}</h1>
                                <p class="text-body-secondary mb-4">{{ 'password.reset.request_help'|trans }}</p>

                                <ul class="nav nav-pills nav-justified mb-4" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active" id="reset-email-tab" data-bs-toggle="pill" data-bs-target="#reset-email" type="button" role="tab" aria-controls="reset-email" aria-selected="true">
                                            <i class="fa-solid fa-envelope me-1" aria-hidden="true"></i>{{ 'password.reset.method_email'|trans }}
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" id="reset-code-tab" data-bs-toggle="pill" data-bs-target="#reset-code" type="button" role="tab" aria-controls="reset-code" aria-selected="false">
                                            <i class="fa-solid fa-user-shield me-1" aria-hidden="true"></i>{{ 'password.reset.method_admin'|trans }}
                                        </button>
                                    </li>
                                </ul>

                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="reset-email" role="tabpanel" aria-labelledby="reset-email-tab" tabindex="0">
                                        <form id="password-reset-request-form" method="post" action="{{ path('app_password_reset_send') }}" class="needs-validation" novalidate data-avalynxform="1">
                                            <div class="mb-3">
                                                <label for="inputResetEmail" class="form-label">{{ 'login.email'|trans }}</label>
                                                <input type="email" class="form-control" id="inputResetEmail" name="email" autocomplete="username" required autofocus />
                                                <div class="invalid-feedback">{{ 'login.email_invalid'|trans }}</div>
                                            </div>
                                            <input type="hidden" name="_token" value="{{ csrf_token('password_reset_request') }}">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>{{ 'password.reset.send'|trans }}
                                            </button>
                                        </form>
                                    </div>
                                    <div class="tab-pane fade" id="reset-code" role="tabpanel" aria-labelledby="reset-code-tab" tabindex="0">
                                        <p class="text-body-secondary mb-3">{{ 'password.reset.code_help'|trans }}</p>
                                        <form id="password-reset-code-form" method="post" action="{{ path('app_password_reset_code_start') }}" class="needs-validation" novalidate data-avalynxform="1">
                                            {% if app.user is null %}
                                                <div class="mb-3">
                                                    <label for="inputCodeEmail" class="form-label">{{ 'login.email'|trans }}</label>
                                                    <input type="email" class="form-control" id="inputCodeEmail" name="email" autocomplete="username" required />
                                                    <div class="invalid-feedback">{{ 'login.email_invalid'|trans }}</div>
                                                </div>
                                            {% endif %}
                                            <input type="hidden" name="_token" value="{{ csrf_token('password_reset_code') }}">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fa-solid fa-key me-2" aria-hidden="true"></i>{{ 'password.reset.code_create'|trans }}
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <p class="text-center mt-4 mb-0">
                                    <a href="{{ path('app_login') }}" class="small">{{ 'password.reset.back_to_login'|trans }}</a>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
