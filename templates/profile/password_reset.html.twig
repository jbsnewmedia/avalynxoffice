{% extends 'base.html.twig' %}

{% block title %}Passwort zurücksetzen{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Neues Passwort festlegen</h4>
                    </div>
                    <div class="card-body">
                        <form id="passwordResetForm" action="{{ path('app_profile_password_reset_submit', { userId: userId }) }}" method="POST">
                            <div class="mb-3">
                                <label for="inputPassword" class="form-label">Neues Passwort</label>
                                <input type="password" class="form-control" id="inputPassword" name="password" required />
                                <div class="form-text">Bitte wählen Sie ein sicheres Passwort.</div>
                            </div>
                            <div class="mb-3">
                                <label for="inputPassword2" class="form-label">Passwort wiederholen</label>
                                <input type="password" class="form-control" id="inputPassword2" name="password_confirm" required />
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">Passwort speichern</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
