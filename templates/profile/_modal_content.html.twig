<div class="p-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-body">
            <strong>{{ 'profile.title'|trans }}</strong>
        </div>
        <div class="card-body">
            {% if user %}
                <div class="mb-3">
                    <label class="form-label text-body-secondary small">{{ 'profile.email'|trans }}</label>
                    <div class="fw-semibold">{{ user.email }}</div>
                </div>
                <div class="mb-0">
                    <label class="form-label text-body-secondary small">{{ 'profile.roles'|trans }}</label>
                    <div>
                        {% for role in user.roles %}
                            <span class="badge bg-body-tertiary text-dark border">{{ role }}</span>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <p class="text-danger">{{ 'profile.no_user'|trans }}</p>
            {% endif %}
        </div>
    </div>

    {% if user %}
        <div class="card shadow-sm">
            <div class="card-header bg-body">
                <strong>{{ 'profile.recovery.title'|trans }}</strong>
            </div>
            <div class="card-body">
                <p class="text-body-secondary">{{ 'profile.recovery.help'|trans }}</p>

                {% if user.recoveryAddresses|length > 0 %}
                    <ul class="list-group mb-3">
                        {% for address in user.recoveryAddresses %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="fa-regular fa-envelope me-2 text-body-secondary" aria-hidden="true"></i>{{ address.email }}</span>
                                <form method="post" action="{{ path('app_profile_recovery_remove', {id: address.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remove_recovery_' ~ address.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger confirm-action" data-confirm="{{ 'profile.recovery.confirm_remove'|trans }}" aria-label="{{ 'profile.recovery.remove'|trans }}" title="{{ 'profile.recovery.remove'|trans }}">
                                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-body-secondary small">{{ 'profile.recovery.empty'|trans }}</p>
                {% endif %}

                {% if user.recoveryAddresses|length < 2 %}
                    <form id="profile-recovery-add-form" method="post" action="{{ path('app_profile_recovery_add') }}" class="row g-2 align-items-end needs-validation" novalidate data-avalynxform="1">
                        <div class="col-sm-8">
                            <label for="recoveryEmail" class="form-label visually-hidden">{{ 'profile.recovery.email_label'|trans }}</label>
                            <input type="email" class="form-control" id="recoveryEmail" name="email" placeholder="{{ 'profile.recovery.email_placeholder'|trans }}" autocomplete="email" required />
                            <div class="invalid-feedback">{{ 'login.email_invalid'|trans }}</div>
                        </div>
                        <div class="col-sm-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('add_recovery') }}">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>{{ 'profile.recovery.add'|trans }}
                            </button>
                        </div>
                    </form>
                {% else %}
                    <p class="text-body-secondary small mb-0">{{ 'profile.recovery.limit_reached'|trans }}</p>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
