{% extends 'base.html.twig' %}
{% block title %}{{ 'password.reset.flow_title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'guest' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, showLanguageDropdown: true } %}
    <section class="py-5 flex-grow-1 d-flex align-items-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                    <div class="card shadow mx-auto" id="password-reset-flow"
                         data-state="{{ state }}"
                         data-seconds-left="{{ secondsLeft }}"
                         data-status-url="{{ statusUrl }}"
                         data-countdown-template="{{ 'password.reset.flow_countdown'|trans({'%seconds%': '__seconds__'}) }}">
                        <div class="card-body p-4 p-md-5">
                            <h1 class="h4 mb-1">{{ 'password.reset.flow_title'|trans }}</h1>

                            {% if state in ['pending', 'claimed', 'released'] %}
                                <p class="text-body-secondary mb-4">{{ 'password.reset.flow_help'|trans }}</p>
                            {% endif %}

                            {% if state in ['pending', 'claimed'] %}
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">{{ 'password.reset.flow_token'|trans }}</label>
                                    <div><code class="fs-5">{{ token }}</code></div>
                                </div>
                                <p class="mb-4">{{ 'password.reset.flow_pending_help'|trans }}</p>
                                <p class="mb-1 d-flex align-items-center gap-2">
                                    <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                                    {{ 'password.reset.flow_waiting'|trans }}
                                </p>
                                <p class="text-body-secondary small mb-0"><span id="flow-countdown"></span></p>
                            {% elseif state == 'released' %}
                                <form id="password-reset-flow-form" method="post" action="{{ submitUrl }}" class="needs-validation" novalidate data-avalynxform="1">
                                    <div class="mb-3">
                                        <label for="inputFlowPassword" class="form-label">{{ 'password.reset.new_password'|trans }}</label>
                                        <input type="password" class="form-control" id="inputFlowPassword" name="password" autocomplete="new-password" required autofocus />
                                        <div class="invalid-feedback">{{ 'password.reset.empty_password'|trans }}</div>
                                    </div>
                                    <div class="mb-4">
                                        <label for="inputFlowPasswordConfirm" class="form-label">{{ 'password.reset.new_password_confirm'|trans }}</label>
                                        <input type="password" class="form-control" id="inputFlowPasswordConfirm" name="password_confirm" autocomplete="new-password" required />
                                        <div class="invalid-feedback">{{ 'password.reset.password_mismatch'|trans }}</div>
                                    </div>
                                    <input type="hidden" name="_token" value="{{ csrf_token('user_password_reset_submit') }}">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa-solid fa-lock me-2" aria-hidden="true"></i>{{ 'password.reset.submit'|trans }}
                                    </button>
                                </form>
                                <p class="text-body-secondary small text-center mt-3 mb-0"><span id="flow-countdown"></span></p>
                            {% elseif state == 'completed' %}
                                <div class="alert alert-success mb-4" role="status">{{ 'password.reset.flow_success'|trans }}</div>
                            {% else %}
                                <div class="alert alert-{{ state in ['expired', 'invalidated'] ? 'warning' : 'danger' }} mb-4" role="alert">
                                    {{ state in ['expired', 'invalidated'] ? 'password.reset.flow_expired'|trans : 'password.reset.flow_invalid'|trans }}
                                </div>
                            {% endif %}

                            {% if state not in ['pending', 'claimed', 'released'] %}
                                <p class="text-center mt-4 mb-0">
                                    <a href="{{ path('app_login') }}" class="small">{{ 'password.reset.back_to_login'|trans }}</a>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
{% if state in ['pending', 'claimed', 'released'] %}
<script>
(function () {
    const wrapper = document.getElementById('password-reset-flow');
    if (!wrapper) {
        return;
    }

    const countdown = document.getElementById('flow-countdown');
    let secondsLeft = parseInt(wrapper.dataset.secondsLeft ?? '0', 10);

    const renderCountdown = () => {
        if (!countdown) {
            return;
        }
        countdown.textContent = secondsLeft > 0
            ? wrapper.dataset.countdownTemplate.replace('__seconds__', String(secondsLeft))
            : '';
    };

    const poll = async () => {
        try {
            const response = await fetch(wrapper.dataset.statusUrl, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });
            if (!response.ok) {
                return;
            }
            const data = await response.json();
            if (typeof data.secondsLeft === 'number') {
                secondsLeft = data.secondsLeft;
                renderCountdown();
            }
            if (data.state !== wrapper.dataset.state) {
                window.location.reload();
            }
        } catch {
            // Transient network problems are ignored; the next poll retries.
        }
    };

    renderCountdown();
    window.setInterval(poll, 5000);
})();
</script>
{% endif %}
{% endblock %}
