{% extends 'base.html.twig' %}
{% block title %}{{ 'password.reset.flow_title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'guest' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, showLanguageDropdown: true } %}
    <section class="py-5 flex-grow-1 d-flex align-items-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                    <div class="card shadow mx-auto">
                        <div class="card-body p-4 p-md-5">
                            <h1 class="h4 mb-1">{{ 'password.reset.flow_title'|trans }}</h1>
                            <p class="text-body-secondary mb-4">{{ 'password.reset.flow_help'|trans }}</p>

                            <form id="password-reset-flow-form" method="post" action="{{ submitUrl }}" class="needs-validation" novalidate data-avalynxform="1">
                                <div class="mb-3">
                                    <label for="inputFlowPassword" class="form-label">{{ 'password.reset.new_password'|trans }}</label>
                                    <input type="password" class="form-control" id="inputFlowPassword" name="password" autocomplete="new-password" required autofocus />
                                    <div class="invalid-feedback">{{ 'password.reset.empty_password'|trans }}</div>
                                </div>
                                <div class="mb-4">
                                    <label for="inputFlowPasswordConfirm" class="form-label">{{ 'password.reset.new_password_confirm'|trans }}</label>
                                    <input type="password" class="form-control" id="inputFlowPasswordConfirm" name="password_confirm" autocomplete="new-password" required />
                                    <div class="invalid-feedback">{{ 'password.reset.password_mismatch'|trans }}</div>
                                </div>
                                <input type="hidden" name="_token" value="{{ csrf_token('user_password_reset_submit') }}">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fa-solid fa-lock me-2" aria-hidden="true"></i>{{ 'password.reset.submit'|trans }}
                                </button>
                            </form>
                            <p class="text-center mt-4 mb-0">
                                <a href="{{ path('app_login') }}" class="small">{{ 'password.reset.back_to_login'|trans }}</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
