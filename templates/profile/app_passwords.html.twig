{% extends 'base.html.twig' %}
{% block title %}{{ 'profile.app_passwords.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block flashes %}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'profile/_nav.html.twig' with { active: 'app_passwords' } %}
            {% include '_flashes.html.twig' %}

            <h1 class="h3 mb-4">{{ 'profile.app_passwords.title'|trans }}</h1>

            {% if newPassword %}
                <div class="alert alert-success shadow-sm" role="alert">
                    <h2 class="h6 fw-semibold mb-2"><i class="fa-solid fa-key me-2" aria-hidden="true"></i>{{ 'profile.app_passwords.created_title'|trans({'%label%': newPassword.label}) }}</h2>
                    <p class="mb-2">{{ 'profile.app_passwords.created_hint'|trans }}</p>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="newAppPassword" value="{{ newPassword.password }}" readonly placeholder="" aria-label="{{ 'profile.app_passwords.password'|trans }}">
                        <button type="button" class="btn btn-secondary" data-copy-target="#newAppPassword" aria-label="{{ 'common.copy'|trans }}" title="{{ 'common.copy'|trans }}">
                            <i class="fa-solid fa-copy" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p class="small text-body-secondary mt-2 mb-0">{{ 'profile.app_passwords.username_hint'|trans({'%email%': app.user.email}) }}</p>
                </div>
            {% endif %}

            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-body-secondary">{{ 'profile.app_passwords.description'|trans }}</p>

                    <div class="card bg-body-tertiary border-0 mb-3" data-eas-connection-box>
                        <div class="card-body">
                            <h2 class="h6 fw-semibold mb-3"><i class="fa-solid fa-mobile-screen-button me-2" aria-hidden="true"></i>{{ 'profile.app_passwords.eas_box_title'|trans }}</h2>
                            <dl class="row mb-0">
                                {% if eas.configured and eas.url %}
                                    <dt class="col-sm-4 col-lg-3">{{ 'profile.app_passwords.eas_box_server'|trans }}</dt>
                                    <dd class="col-sm-8 col-lg-9" data-eas-server-url><code>{{ eas.url }}</code></dd>
                                {% endif %}
                                <dt class="col-sm-4 col-lg-3">{{ 'profile.app_passwords.eas_box_user'|trans }}</dt>
                                <dd class="col-sm-8 col-lg-9"><code>{{ app.user.email }}</code></dd>
                                <dt class="col-sm-4 col-lg-3">{{ 'profile.app_passwords.eas_box_password'|trans }}</dt>
                                <dd class="col-sm-8 col-lg-9 mb-0">{{ 'profile.app_passwords.eas_box_password_hint'|trans }}</dd>
                            </dl>
                            {% if not eas.configured %}
                                <p class="small text-body-secondary mb-0 mt-2">{{ 'profile.app_passwords.eas_box_not_configured'|trans }}</p>
                            {% endif %}
                        </div>
                    </div>

                    {% if passwords|length > 0 %}
                        <ul class="list-group mb-3">
                            {% for password in passwords %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fa-solid fa-key me-2 text-body-secondary" aria-hidden="true"></i>{{ password.label }}
                                        <span class="d-block small text-body-secondary">
                                            {{ 'profile.app_passwords.created_at'|trans }}: {{ password.createdAt|user_datetime }}
                                            · {{ 'profile.app_passwords.last_used'|trans }}: {% if password.lastUsedAt %}{{ password.lastUsedAt|user_datetime }}{% else %}{{ 'profile.app_passwords.never_used'|trans }}{% endif %}
                                        </span>
                                    </span>
                                    <span class="d-inline-flex gap-1">
                                        <form method="post" action="{{ path('app_profile_app_passwords_revoke', {id: password.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('app_password_revoke_' ~ password.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger confirm-action" data-confirm="{{ 'profile.app_passwords.confirm_revoke'|trans }}" aria-label="{{ 'profile.app_passwords.revoke'|trans }}" title="{{ 'profile.app_passwords.revoke'|trans }}">
                                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-body-secondary small">{{ 'profile.app_passwords.none'|trans }}</p>
                    {% endif %}

                    {% if canCreate %}
                        <form id="profile-app-password-create-form" method="post" action="{{ path('app_profile_app_passwords_create') }}" class="needs-validation" novalidate data-avalynxform="1">
                            <input type="hidden" name="_token" value="{{ csrf_token('app_password_create') }}">
                            <div class="form-group">
                                <label for="appPasswordLabel" class="form-label visually-hidden">{{ 'profile.app_passwords.label'|trans }}</label>
                                <input type="text" class="form-control" id="appPasswordLabel" name="label" maxlength="{{ maxLabelLength }}" required placeholder="{{ 'profile.app_passwords.label_placeholder'|trans }}" />
                                <div class="invalid-feedback" aria-live="polite"></div>
                            </div>
                            <div class="text-end mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>{{ 'profile.app_passwords.create'|trans }}
                                </button>
                            </div>
                        </form>
                    {% else %}
                        <p class="text-body-secondary small mb-0">{{ 'profile.app_passwords.limit_reached'|trans({'%max%': maxActive}) }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-copy-target]').forEach(function (button) {
                button.addEventListener('click', function () {
                    var input = document.querySelector(button.dataset.copyTarget);
                    if (!input) {
                        return;
                    }
                    input.select();
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(input.value).catch(function () {
                            document.execCommand('copy');
                        });
                    } else {
                        document.execCommand('copy');
                    }
                });
            });
        });
    </script>
{% endblock %}
