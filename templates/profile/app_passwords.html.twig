{% extends 'base.html.twig' %}
{% block title %}{{ 'profile.app_passwords.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'profile/_nav.html.twig' with { active: 'app_passwords' } %}
            <h1 class="h4 mb-1">{{ 'profile.app_passwords.title'|trans }}</h1>
            <p class="text-body-secondary mb-4">{{ 'profile.app_passwords.description'|trans }}</p>

            {% if newPassword %}
                <div class="alert alert-success shadow-sm" role="alert">
                    <h2 class="h6 fw-semibold mb-2"><i class="fa-solid fa-key me-2" aria-hidden="true"></i>{{ 'profile.app_passwords.created_title'|trans({'%label%': newPassword.label}) }}</h2>
                    <p class="mb-2">{{ 'profile.app_passwords.created_hint'|trans }}</p>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="newAppPassword" value="{{ newPassword.password }}" readonly aria-label="{{ 'profile.app_passwords.password'|trans }}">
                        <button type="button" class="btn btn-outline-secondary" data-copy-target="#newAppPassword" aria-label="{{ 'common.copy'|trans }}" title="{{ 'common.copy'|trans }}">
                            <i class="fa-solid fa-copy" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p class="small text-body-secondary mt-2 mb-0">{{ 'profile.app_passwords.username_hint'|trans({'%email%': app.user.email}) }}</p>
                </div>
            {% endif %}

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6 fw-semibold mb-3">{{ 'profile.app_passwords.create'|trans }}</h2>
                    {% if canCreate %}
                        <form method="post" action="{{ path('app_profile_app_passwords_create') }}" class="row g-2 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('app_password_create') }}">
                            <div class="col-md-8">
                                <label for="appPasswordLabel" class="form-label">{{ 'profile.app_passwords.label'|trans }}</label>
                                <input type="text" class="form-control" id="appPasswordLabel" name="label" maxlength="{{ maxLabelLength }}" required placeholder="{{ 'profile.app_passwords.label_placeholder'|trans }}">
                            </div>
                            <div class="col-md-4 d-grid">
                                <button type="submit" class="btn btn-primary" aria-label="{{ 'profile.app_passwords.create'|trans }}">
                                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>{{ 'profile.app_passwords.create'|trans }}
                                </button>
                            </div>
                        </form>
                    {% else %}
                        <p class="text-body-secondary mb-0">{{ 'profile.app_passwords.limit_reached'|trans({'%max%': maxActive}) }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>{{ 'profile.app_passwords.label'|trans }}</th>
                                    <th>{{ 'profile.app_passwords.created_at'|trans }}</th>
                                    <th>{{ 'profile.app_passwords.last_used'|trans }}</th>
                                    <th class="text-end">{{ 'account.actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for password in passwords %}
                                <tr>
                                    <td class="fw-medium">{{ password.label }}</td>
                                    <td>{{ password.createdAt|user_datetime('short') }}</td>
                                    <td>
                                        {% if password.lastUsedAt %}
                                            {{ password.lastUsedAt|user_datetime('short') }}
                                        {% else %}
                                            <span class="text-body-secondary">{{ 'profile.app_passwords.never_used'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <form method="post" action="{{ path('app_profile_app_passwords_revoke', {id: password.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('app_password_revoke_' ~ password.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="{{ 'profile.app_passwords.revoke'|trans }}" title="{{ 'profile.app_passwords.revoke'|trans }}">
                                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-body-secondary text-center py-4">{{ 'profile.app_passwords.none'|trans }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('[data-copy-target]').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = document.querySelector(button.dataset.copyTarget);
                if (!input) {
                    return;
                }
                input.select();
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(input.value);
                } else {
                    document.execCommand('copy');
                }
            });
        });
    </script>
{% endblock %}
