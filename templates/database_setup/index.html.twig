{% extends 'base.html.twig' %}

{% block title %}{{ 'database_setup.title'|trans }}{% endblock %}

{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'guest' } %}
    {{ parent() }}
    <style>
        .terminal-window {
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            background: #212529;
            margin-bottom: 2rem;
        }
        .terminal-header {
            background: #343a40;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #495057;
        }
        .terminal-buttons {
            display: flex;
            gap: 6px;
            margin-right: 15px;
        }
        .terminal-button {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        .btn-red { background: #ff5f56; }
        .btn-yellow { background: #ffbd2e; }
        .btn-green { background: #27c93f; }
        .terminal-title {
            color: #adb5bd;
            font-size: 0.85rem;
            font-family: sans-serif;
            flex-grow: 1;
            text-align: center;
            margin-right: 40px;
        }
        .terminal-body {
            padding: 0;
        }
        pre.terminal-content {
            margin: 0;
            padding: 20px;
            color: #f8f9fa;
            font-family: 'Fira Code', 'Cascadia Code', 'Ubuntu Mono', 'Source Code Pro', Menlo, Monaco, Consolas, monospace;
            font-size: 0.9rem;
            line-height: 1.5;
            max-height: 500px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }
        /* Custom scrollbar for terminal */
        pre.terminal-content::-webkit-scrollbar {
            width: 8px;
        }
        pre.terminal-content::-webkit-scrollbar-track {
            background: #212529;
        }
        pre.terminal-content::-webkit-scrollbar-thumb {
            background: #495057;
            border-radius: 4px;
        }
        pre.terminal-content::-webkit-scrollbar-thumb:hover {
            background: #6c757d;
        }
        .step-badge {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-weight: bold;
        }
        .status-pill {
            padding: 0.4rem 0.8rem;
            border-radius: 50rem;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="d-flex flex-column min-vh-100 bg-body-tertiary">
        {% include '_navbar.html.twig' with { showMailToggles: false, showLanguageDropdown: true } %}

        <main class="flex-grow-1 py-5">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
                            <div>
                                <h1 class="display-5 fw-bold text-dark mb-1">
                                    <i class="fas fa-server text-primary me-2"></i>{{ 'database_setup.title'|trans }}
                                </h1>
                                <p class="text-body-secondary mb-0">{{ 'database_setup.subtitle'|trans }}</p>
                            </div>
                            <div>
                                {% set hasError = logs|filter(l => l.status == 'error')|length > 0 %}
                                {% if hasError %}
                                    <div class="alert alert-danger d-flex align-items-center mb-0 shadow-sm">
                                        <i class="fas fa-exclamation-triangle me-3 fa-2x"></i>
                                        <div>
                                            <div class="fw-bold">{{ 'database_setup.error_title'|trans }}</div>
                                            <small>{{ 'database_setup.error_subtitle'|trans }}</small>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="alert alert-success d-flex align-items-center mb-0 shadow-sm">
                                        <i class="fas fa-check-circle me-3 fa-2x"></i>
                                        <div>
                                            <div class="fw-bold">{{ 'database_setup.success_title'|trans }}</div>
                                            <small>{{ 'database_setup.success_subtitle'|trans }}</small>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {% for log in logs %}
                            <div class="mb-5">
                                <div class="d-flex align-items-center mb-3">
                                    <span class="step-badge {% if log.status == 'success' %}text-bg-success{% elseif log.status == 'warning' %}text-bg-warning{% else %}text-bg-danger{% endif %} shadow-sm">
                                        {{ loop.index }}
                                    </span>
                                    <h3 class="h4 mb-0 me-3">{{ log.label }}</h3>
                                    <span class="status-pill {% if log.status == 'success' %}bg-success-subtle text-success border border-success-subtle{% elseif log.status == 'warning' %}bg-warning-subtle text-warning border border-warning-subtle{% else %}bg-danger-subtle text-danger border border-danger-subtle{% endif %}">
                                        {{ ('database_setup.status.' ~ log.status)|trans }}
                                    </span>
                                    <div class="ms-auto d-none d-sm-block">
                                        {% if log.command == 'fs-operations' %}
                                            <span class="text-body-secondary small">{{ 'database_setup.fs_operations'|trans }}</span>
                                        {% else %}
                                            <code class="text-body-secondary small">php bin/console {{ log.command }}</code>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="terminal-window">
                                    <div class="terminal-header">
                                        <div class="terminal-buttons">
                                            <div class="terminal-button btn-red"></div>
                                            <div class="terminal-button btn-yellow"></div>
                                            <div class="terminal-button btn-green"></div>
                                        </div>
                                        <div class="terminal-title">
                                            {{ log.command }} &mdash; {{ 'database_setup.exit_code'|trans }}: {{ log.exitCode }}
                                        </div>
                                    </div>
                                    <div class="terminal-body">
                                        <pre class="terminal-content">{% if log.output %}{{ log.output|trim }}{% else %}{{ 'common.no_output'|trans }}{% endif %}</pre>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="card shadow-sm border-0 py-5 text-center">
                                <div class="card-body">
                                    <i class="fas fa-inbox fa-3x text-body-secondary mb-3"></i>
                                    <h3>{{ 'database_setup.no_commands_title'|trans }}</h3>
                                    <p class="text-body-secondary">{{ 'database_setup.no_commands_subtitle'|trans }}</p>
                                    <a href="/" class="btn btn-primary mt-3">{{ 'database_setup.go_home'|trans }}</a>
                                </div>
                            </div>
                        {% endfor %}

                        <div class="d-flex justify-content-center gap-3 mt-5 pt-4 border-top">
                            <a href="/" class="btn btn-lg btn-outline-secondary px-5">
                                <i class="fas fa-arrow-left me-2"></i>{{ 'database_setup.back_home'|trans }}
                            </a>
                            <a href="{{ path('app_login') }}" class="btn btn-lg btn-primary px-5 shadow">
                                <i class="fas fa-sign-in-alt me-2"></i>{{ 'database_setup.go_login'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="py-4 bg-body border-top mt-auto">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-body-secondary small">© {{ "now"|date("Y") }} - <strong>JBS</strong> New Media GmbH</span>
                <ul class="nav small">
                    <li class="nav-item text-body-secondary">{{ 'database_setup.tool_label'|trans }}</li>
                </ul>
            </div>
        </footer>
    </div>
{% endblock %}
