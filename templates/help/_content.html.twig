<div class="p-4">
    <section class="mb-5">
        <h2 class="h5">{{ 'help.gestures.title'|trans }}</h2>
        <ul class="list-unstyled ms-2">
            <li class="mb-2"><strong>{{ 'help.gestures.tap_click'|trans }}:</strong> {{ 'help.gestures.tap_click_description'|trans }}</li>
            <li class="mb-2"><strong>{{ 'help.gestures.double_click'|trans }}:</strong> {{ 'help.gestures.double_click_description'|trans }}</li>
            <li class="mb-2"><strong>{{ 'help.gestures.long_press'|trans }}:</strong> {{ 'help.gestures.long_press_description'|trans }}</li>
            <li class="mb-2"><strong>{{ 'help.gestures.drag_drop'|trans }}:</strong> {{ 'help.gestures.drag_drop_description'|trans }}</li>
        </ul>
    </section>
    <section class="mb-5">
        <h2 class="h5">{{ 'help.symbols.title'|trans }}</h2>
        <div class="row row-cols-1 g-3">
            <div class="col">
                <div class="d-flex align-items-center p-3 border rounded">
                    <i class="fa-solid fa-envelope me-3" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">{{ 'email.mark_unread'|trans }}</div>
                        <div class="text-body-secondary small">{{ 'help.symbols.mark_unread_description'|trans }}</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center p-3 border rounded">
                    <i class="fa-solid fa-envelope-open me-3" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">{{ 'email.mark_read'|trans }}</div>
                        <div class="text-body-secondary small">{{ 'help.symbols.mark_read_description'|trans }}</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center p-3 border rounded">
                    <i class="fa-solid fa-reply me-3" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">{{ 'email.reply'|trans }}</div>
                        <div class="text-body-secondary small">{{ 'help.symbols.reply_description'|trans }}</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center p-3 border rounded">
                    <i class="fa-solid fa-trash me-3" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">{{ 'email.delete'|trans }}</div>
                        <div class="text-body-secondary small">{{ 'help.symbols.delete_description'|trans }}</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center p-3 border rounded">
                    <i class="fa-solid fa-print me-3" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">{{ 'email.print'|trans }}</div>
                        <div class="text-body-secondary small">{{ 'help.symbols.print_description'|trans }}</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="d-flex align-items-center p-3 border rounded">
                    <i class="fa-solid fa-ellipsis-vertical me-3" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">{{ 'email.more_actions'|trans }}</div>
                        <div class="text-body-secondary small">{{ 'help.symbols.more_actions_description'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <h2 class="h5">{{ 'help.faq.title'|trans }}</h2>
        <p class="text-body-secondary">{{ 'help.more_coming'|trans }}</p>
    </section>
</div>
