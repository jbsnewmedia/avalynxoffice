{# Params:
    accounts (list<Account>) — accounts selectable by the user
    activeAccount (Account|null) — currently selected account, null for all
    activeAccountId (string) — 'all' or the selected account id
    optionRoute (string) — route used for the scope options
    optionParams (array) — base route params for the options (e.g. {groupId: activeGroup})
    allLabel (string) — label for the "all accounts" scope
#}
<div class="p-3 border-bottom">
    <h6 class="text-uppercase text-body-secondary fw-bold small mb-2">{{ 'mail.accounts'|trans }}</h6>
    <div class="dropdown w-100 mb-3 account-dropdown" data-bs-auto-close="outside">
        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'mail.switch_account'|trans }}">
            <i class="fa-solid fa-inbox me-2" aria-hidden="true"></i>
            <span class="flex-grow-1">{{ activeAccount ? (activeAccount.name ?: activeAccount.email) : allLabel }}</span>
        </button>
        <ul class="dropdown-menu w-100">
            <li class="px-2 py-0">
                <div class="input-group input-group-sm search-group">
                    <span class="input-group-text" id="account-filter-search-label"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                    <input type="text" class="form-control account-search" placeholder="{{ 'search.placeholder'|trans }}" aria-label="{{ 'mail.search_accounts'|trans }}" aria-describedby="account-filter-search-label">
                    <button class="btn btn-outline-secondary d-none" type="button" title="{{ 'search.clear'|trans }}" aria-label="{{ 'search.clear'|trans }}" data-action="clear-account-search">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center account-option {{ activeAccount is null ? 'active' : '' }}"
                   href="{{ path(optionRoute, optionParams|merge({account: 'all'})) }}"
                   aria-label="{{ allLabel }}">
                    <i class="fa-solid fa-layer-group me-2" aria-hidden="true"></i>
                    {{ allLabel }}
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            {% for mb in accounts %}
                <li>
                    <a class="dropdown-item d-flex align-items-center account-option {{ activeAccount and activeAccount.id == mb.id ? 'active' : '' }}"
                       href="{{ path(optionRoute, optionParams|merge({account: mb.id})) }}"
                       aria-label="{{ 'mail.open_account'|trans({'%name%': mb.name ?: mb.email}) }}">
                        <i class="fa-solid fa-inbox me-2" aria-hidden="true"></i>
                        {{ mb.name ?: mb.email }}
                    </a>
                </li>
            {% else %}
                <li><span class="dropdown-item text-body-secondary">{{ 'mail.none'|trans }}</span></li>
            {% endfor %}
            <li class="account-no-results d-none"><span class="dropdown-item text-body-secondary">{{ 'search.no_results'|trans }}</span></li>
        </ul>
    </div>
    {% block action %}{% endblock %}
</div>
