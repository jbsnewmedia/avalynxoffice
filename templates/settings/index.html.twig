{% extends 'base.html.twig' %}
{% block title %}{{ 'settings.title'|trans }} - {{ 'app.title'|trans }}{% endblock %}
{% block stylesheets %}
    {% include '_assets.html.twig' with { mode: 'user' } %}
    {{ parent() }}
{% endblock %}
{% block body %}
<div class="d-flex flex-column min-vh-100">
    {% include '_navbar.html.twig' with { showMailToggles: false, userMenuActive: true } %}
    <main class="flex-grow-1 py-4">
        <div class="container">
            {% include 'settings/_nav.html.twig' with { active: 'overview' } %}

            <h1 class="h3 mb-2">{{ 'settings.title'|trans }}</h1>
            <p class="text-body-secondary mb-0">{{ 'settings.dashboard.description'|trans }}</p>
        </div>
    </main>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
{% endblock %}
