{% set scopeParams = activeAccountId is defined and activeAccountId != 'all' ? {account: activeAccountId} : {} %}
{% set qParams = search is defined and search is not empty ? {q: search} : {} %}
{% set extraParams = scopeParams|merge(qParams) %}
<div class="p-3">
    <h6 class="text-uppercase text-body-secondary fw-bold small mb-2">{{ 'calendar.groups'|trans }}</h6>
    <div class="list-group list-group-flush">
        <a href="{{ path('calendar_month', {monthKey: 'all'}|merge(extraParams)) }}"
           class="list-group-item list-group-item-action d-flex align-items-center {{ activeMonth == 'all' ? 'active' : '' }}"
           {% if activeMonth == 'all' %}aria-current="page"{% endif %}
           aria-label="{{ 'calendar.open_group'|trans({'%group%': 'calendar.all'|trans}) }}">
            <i class="fa-solid fa-calendar-days me-2" aria-hidden="true"></i>
            <span>{{ 'calendar.all'|trans }}</span>
            <span class="badge bg-primary rounded-pill ms-auto group-count-badge" aria-label="{{ 'calendar.count'|trans({'%count%': totalEvents}) }}">{{ totalEvents }}</span>
        </a>
        {% for monthKey, group in groups %}
            <a href="{{ path('calendar_month', {monthKey: monthKey}|merge(extraParams)) }}"
               class="list-group-item list-group-item-action d-flex align-items-center {{ activeMonth == monthKey ? 'active' : '' }}"
               {% if activeMonth == monthKey %}aria-current="page"{% endif %}
               aria-label="{{ 'calendar.open_group'|trans({'%group%': group.label}) }}">
                <i class="fa-solid fa-folder me-2" aria-hidden="true"></i>
                <span>{{ group.label }}</span>
                <span class="badge bg-primary rounded-pill ms-auto group-count-badge" aria-label="{{ 'calendar.count'|trans({'%count%': group.count}) }}">{{ group.count }}</span>
            </a>
        {% else %}
            <div class="list-group-item text-body-secondary">{{ 'calendar.none'|trans }}</div>
        {% endfor %}
    </div>
</div>
