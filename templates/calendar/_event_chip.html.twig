{# Params:
    event (AvalynxOffice\Entity\CalendarEvent) — event to render as a grid chip
    monthKey (string) — month key used for the detail route
#}
<a href="{{ path('calendar_event_detail', {monthKey: monthKey, eventId: event.id}) }}"
   class="action-btn-modal calendar-event-chip {{ event.isAllDay ? 'calendar-event-chip-allday' : '' }}"
   data-title="{{ event.title }}"
   title="{{ event.title }}"
   aria-label="{{ 'calendar.item_aria'|trans({'%title%': event.title, '%date%': event.startAt|user_datetime('date')}) }}">
    {% if not event.isAllDay %}
        <span class="calendar-event-time">{{ event.startAt|user_datetime('time') }}</span>
    {% endif %}
    <span class="calendar-event-title">{{ event.title }}</span>
    {% if event.recurrenceType is not null %}
        <i class="fa-solid fa-repeat calendar-event-recurrence" title="{{ 'calendar.recurrence'|trans }}" aria-label="{{ 'calendar.recurrence'|trans }}"></i>
    {% endif %}
</a>
