{# Params:
    grid (array<string, mixed>) — month grid data: {anchor, weeks: list of weeks with day cells}
    activeMailboxId (string) — active mailbox id or 'all'
    search (string) — active search term
#}
{% set scopeParams = activeMailboxId != 'all' ? {mailbox: activeMailboxId} : {} %}
{% set qParams = search is not empty ? {q: search} : {} %}
<div class="calendar-grid" role="grid" aria-label="{{ 'calendar.title'|trans }}">
    <div class="calendar-grid-header" role="row">
        {% for weekday in 1..7 %}
            <div class="calendar-grid-weekday" role="columnheader" aria-label="{{ ('calendar.weekday.' ~ weekday)|trans }}">{{ ('calendar.weekday_short.' ~ weekday)|trans }}</div>
        {% endfor %}
    </div>
    {% for week in grid.weeks %}
        <div class="calendar-grid-row" role="row">
            {% for day in week %}
                <div class="calendar-grid-cell {{ day.inMonth ? '' : 'calendar-grid-cell-outside' }} {{ day.isToday ? 'calendar-grid-cell-today' : '' }}" data-date="{{ day.date|date('Y-m-d') }}" role="gridcell">
                    <div class="calendar-grid-cell-head">
                        <span class="calendar-grid-day-number" title="{{ ('calendar.weekday.' ~ day.date|date('N'))|trans }}">{{ day.date|date('j') }}</span>
                        {% if day.inMonth %}
                            <a href="{{ path('calendar_new_modal', {date: day.date|date('Y-m-d')}) }}"
                               class="action-btn-modal calendar-grid-add {{ license_manager.isReadOnly ? 'd-none' }}"
                               data-title="{{ 'calendar.new'|trans }}"
                               title="{{ 'calendar.new_on'|trans({'%date%': day.date|date('d.m.')}) }}"
                               aria-label="{{ 'calendar.new_on'|trans({'%date%': day.date|date('d.m.')}) }}"><i class="fa-solid fa-plus" aria-hidden="true"></i></a>
                        {% endif %}
                    </div>
                    <div class="calendar-grid-events">
                        {% for event in day.events|slice(0, 3) %}
                            {% include 'calendar/_event_chip.html.twig' with {event: event, monthKey: day.date|date('Y-m')} %}
                        {% endfor %}
                        {% if day.events|length > 3 %}
                            <a href="{{ path('calendar_month', {monthKey: day.date|date('Y-m'), view: 'day', date: day.date|date('Y-m-d')}|merge(scopeParams)|merge(qParams)) }}"
                               class="calendar-event-more"
                               title="{{ 'calendar.more_aria'|trans({'%count%': day.events|length - 3}) }}"
                               aria-label="{{ 'calendar.more_aria'|trans({'%count%': day.events|length - 3}) }}">+{{ day.events|length - 3 }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
