<div class="p-4">
    {% set aliasesInvalid = is_edit and form.aliases is defined and form.aliases.vars.errors|length > 0 %}
    {% set foldersInvalid = is_edit and form.folders is defined and form.folders.vars.errors|length > 0 %}
    {% set folderFunctionOptions = [
        { value: 'none', label: 'folder.function.none'|trans },
        { value: 'mailbox', label: 'folder.function.mailbox'|trans },
        { value: 'inbox', label: 'folder.function.inbox'|trans },
        { value: 'outbox', label: 'folder.function.outbox'|trans },
        { value: 'scheduled', label: 'folder.function.scheduled'|trans },
        { value: 'drafts', label: 'folder.function.drafts'|trans },
        { value: 'trash', label: 'folder.function.trash'|trans },
    ] %}
    {{ form_start(form, {'attr': {'id': 'account-form', 'data-avalynxform': '1', 'novalidate': 'novalidate'}}) }}
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                    <div class="invalid-feedback" aria-live="polite"></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    <div class="invalid-feedback" aria-live="polite"></div>
                </div>
            </div>
            <div class="col-12">
                <div class="form-group mb-3">
                    <input type="text"
                           id="{{ form.users.vars.id }}_autocomplete"
                           data-user-autocomplete="1"
                           data-target-input-id="{{ form.users.vars.id }}"
                           data-source-url="{{ path('account_users_suggestions') }}"
                           data-placeholder="{{ 'account.users_placeholder'|trans }}"
                           data-no-results="{{ 'account.users_no_results'|trans }}"
                           data-clear-title="{{ 'email.autocomplete_clear'|trans }}"
                           data-remove-title="{{ 'email.autocomplete_remove'|trans }}"
                           data-default-selections="{{ users_autocomplete_defaults|default([])|json_encode|e('html_attr') }}">
                    {{ form_widget(form.users, {'attr': {'class': 'd-none'}}) }}
                    {{ form_help(form.users) }}
                    <div class="invalid-feedback" aria-live="polite"></div>
                </div>
            </div>
        </div>

        <hr class="my-4">
            <div class="account-list-editor account-list-editor-aliases{%- if aliasesInvalid %} account-list-editor-invalid{% endif %}"
         data-account-list-editor
         data-account-list-type="alias"
         data-alias-connector-options="{{ connectorOptions|json_encode|e('html_attr') }}"
         data-connector-placeholder="{{ 'account.alias_connector'|trans }}"
         data-connector-search-placeholder="{{ 'search.placeholder'|trans }}"
         data-autocomplete-no-results="{{ 'email.autocomplete_no_results'|trans }}">
        {{ form_label(form.aliases, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.aliases, {'attr': {'class': 'd-none', 'data-account-list-storage': 'true'}}) }}
        <div class="account-list-row account-list-row-add">
            <input type="text"
                   class="form-control"
                   id="{{ form.aliases.vars.id }}_local_part"
                   data-account-alias-local-part="1"
                   placeholder="{{ 'account.alias_local_part'|trans }}"
                   aria-label="{{ 'account.alias_local_part'|trans }}"
                   autocomplete="off">
            <select id="{{ form.aliases.vars.id }}_connector"
                    class="form-select"
                    data-account-alias-connector="1"
                    aria-label="{{ 'account.alias_connector'|trans }}"></select>
            <button type="button" class="btn btn-primary" data-account-list-add aria-label="{{ 'account.add_alias'|trans }}" title="{{ 'account.add_alias'|trans }}">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
            </button>
        </div>
        <div class="account-list-items" data-account-list-items data-remove-label="{{ 'account.remove_alias'|trans }}" data-confirm-message="{{ 'account.confirm_remove_alias'|trans }}"></div>
        <div class="account-list-empty text-body-secondary small" data-account-list-empty>{{ 'account.aliases_empty'|trans }}</div>
        {{ form_help(form.aliases) }}
        {{ form_errors(form.aliases) }}
        <span class="invalid-feedback d-block" data-account-list-feedback{%- if not aliasesInvalid %} style="display: none;"{% endif %}></span>
    </div>

        {% if is_edit %}
            <hr class="my-4">
            <div class="account-list-editor account-list-editor-folders{% if foldersInvalid %} account-list-editor-invalid{% endif %}"
                 data-account-list-editor
                 data-account-list-type="folder"
                 data-primary-label="{{ 'account.folder_name'|trans }}"
                 data-primary-placeholder="{{ 'account.folders_placeholder'|trans }}"
                 data-secondary-label="{{ 'account.sort_order'|trans }}"
                 data-secondary-placeholder="{{ 'account.sort_order_placeholder'|trans }}"
                 data-tertiary-label="{{ 'account.folder_functions'|trans }}"
                 data-tertiary-placeholder="{{ 'account.folder_functions_placeholder'|trans }}"
                 data-folder-function-options="{{ folderFunctionOptions|json_encode|e('html_attr') }}"
                 data-autocomplete-no-results="{{ 'email.autocomplete_no_results'|trans }}">
                {{ form_label(form.folders, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.folders, {'attr': {'class': 'd-none', 'data-account-list-storage': 'true'}}) }}
                <div class="account-list-row account-list-row-add">
                    <input type="text"
                           class="form-control"
                           id="{{ form.folders.vars.id }}_name"
                           data-account-folder-name="1"
                           placeholder="{{ 'account.folders_placeholder'|trans }}"
                           aria-label="{{ 'account.folder_name'|trans }}"
                           autocomplete="off">
                    <input type="number"
                           class="form-control"
                           id="{{ form.folders.vars.id }}_sort"
                           data-account-folder-sort="1"
                           placeholder="{{ 'account.sort_order_placeholder'|trans }}"
                           aria-label="{{ 'account.sort_order'|trans }}"
                           autocomplete="off">
                    <input type="text"
                           class="form-control"
                           id="{{ form.folders.vars.id }}_functions"
                           data-account-folder-functions="1"
                           placeholder="{{ 'account.folder_functions_placeholder'|trans }}"
                           aria-label="{{ 'account.folder_functions'|trans }}"
                           autocomplete="off">
                    <button type="button" class="btn btn-primary" data-account-list-add aria-label="{{ 'account.add_folder'|trans }}" title="{{ 'account.add_folder'|trans }}">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="account-list-items" data-account-list-items data-remove-label="{{ 'account.remove_folder'|trans }}" data-confirm-message="{{ 'account.confirm_remove_folder'|trans }}"></div>
                <div class="account-list-empty text-body-secondary small" data-account-list-empty>{{ 'account.folders_empty'|trans }}</div>
                {{ form_help(form.folders) }}
                {{ form_errors(form.folders) }}
                <span class="invalid-feedback d-block" data-account-list-feedback{% if not foldersInvalid %} style="display: none;"{% endif %}></span>
            </div>
        {% else %}
            <p class="text-body-secondary small mb-0 mt-3">{{ 'account.create_hint'|trans }}</p>
        {% endif %}

        <div class="modal-form-buttons d-none">
            {{ form_widget(form.save) }}
        </div>
    {{ form_end(form) }}
</div>
