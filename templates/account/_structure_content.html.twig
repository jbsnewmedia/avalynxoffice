<div>
    <h6 class="mb-1">{{ 'account.structure_title'|trans }}</h6>
    <p class="text-body-secondary mb-3">{{ 'account.structure_description'|trans }}</p>

    {% if items|length > 0 %}
        <div class="settings-account-structure">
            {% for account in items %}
                <div class="settings-account-card">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                        <div>
                            <div class="fw-semibold">{{ account.name }}</div>
                            <div class="text-body-secondary small">{{ account.email }}</div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <div class="settings-account-list-title">{{ 'account.aliases'|trans }}</div>
                            <ul class="settings-account-list">
                                {% for alias in account.aliases %}
                                    <li>
                                        <span class="fw-medium">{{ alias.localPart }}@{{ alias.connector.domain }}</span>
                                        <span class="text-body-secondary small d-block">{{ 'connector.list'|trans }}: {{ alias.connector.name }}</span>
                                    </li>
                                {% else %}
                                    <li class="text-body-secondary">{{ 'account.no_addresses'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="settings-account-list-title">{{ 'account.users'|trans }}</div>
                            <ul class="settings-account-list">
                                {% for user in account.users %}
                                    <li>{{ user.email }}</li>
                                {% else %}
                                    <li class="text-body-secondary">{{ 'account.no_users'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="settings-account-list-title">{{ 'account.folders'|trans }}</div>
                            <ul class="settings-account-list">
                                {% for folder in account.folders %}
                                    <li>
                                        <span>{{ folder.name }}</span>
                                        {% if folder.functions is empty %}
                                            <span class="badge bg-secondary-subtle text-body ms-1">{{ 'folder.function.none'|trans }}</span>
                                        {% else %}
                                            {% for function in folder.functions %}
                                                <span class="badge bg-secondary-subtle text-body ms-1">{{ ('folder.function.' ~ function)|trans }}</span>
                                            {% endfor %}
                                        {% endif %}
                                    </li>
                                {% else %}
                                    <li class="text-body-secondary">{{ 'folder.none'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-body-secondary small">{{ 'account.none'|trans }}</div>
    {% endif %}
</div>
