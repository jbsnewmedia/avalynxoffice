# Development image: same structure and bootstrap as the production image
# (docker/prod/Dockerfile — wait for the database, run migrations, ensure
# the admin user, then start the web server), with these differences:
#   - built on the webdevops dev base image (webdevops/php-apache-dev),
#   - Symfony runs in dev mode (APP_ENV=dev, APP_DEBUG=1),
#   - Composer dev dependencies and the composer-bin tooling
#     (vendor-bin: phpunit, phpstan, ecs, rector) are included.
# Published as jbsnewmedia/avalynxoffice-dev (latest) by the docker-image
# workflow.
FROM webdevops/php-apache-dev:8.5

ENV WEB_DOCUMENT_ROOT=/app/public \
    APP_ENV=dev \
    APP_DEBUG=1 \
    PHP_MEMORY_LIMIT=512M \
    PHP_MAX_EXECUTION_TIME=300 \
    PHP_POST_MAX_SIZE=200M \
    PHP_UPLOAD_MAX_FILESIZE=100M \
    PHP_DISMOD=ioncube \
    PHP_ENMOD=mailparse

WORKDIR /app

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . /app

RUN COMPOSER_MEMORY_LIMIT=-1 composer install --optimize-autoloader --no-interaction --no-progress \
    && chown -R application:application /app \
    && COMPOSER_MEMORY_LIMIT=-1 composer bin all install

# Same bootstrap as production (see docker/prod/Dockerfile).
COPY docker/prod/office-entrypoint.sh /usr/local/bin/office-entrypoint
COPY docker/prod/office-grant-eas.sh /usr/local/bin/office-grant-eas
COPY docker/prod/eas-grants.sql /usr/local/lib/avalynxoffice/eas-grants.sql
RUN chmod +x /usr/local/bin/office-entrypoint /usr/local/bin/office-grant-eas

ENTRYPOINT ["/usr/local/bin/office-entrypoint"]
CMD ["supervisord"]
