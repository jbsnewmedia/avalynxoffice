{
    "name": "jbsnewmedia/pop3-connector-bundle",
    "version": "0.1.0",
    "description": "POP3/SMTP connector plugin: fetches mail per domain via POP3 and sends via SMTP",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/mailer": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "twig/twig": "^3.22"
    },
    "autoload": {
        "psr-4": {
            "JBSNewMedia\\Pop3ConnectorBundle\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "JBSNewMedia\\Pop3ConnectorBundle\\Pop3ConnectorBundle"
        }
    }
}
