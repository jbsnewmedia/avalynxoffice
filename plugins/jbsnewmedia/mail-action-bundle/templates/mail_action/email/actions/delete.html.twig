{% if license_manager.isReadOnly %}
    <span class="btn btn-primary disabled" data-priority="10" aria-disabled="true" title="{{ 'license.read_only_action'|trans }}">
        <i class="fa-solid fa-lock me-2" aria-hidden="true"></i>{{ 'license.read_only_action'|trans }}
    </span>
{% else %}
<a class="btn btn-primary confirm-action"
   href="{{ path('mail_delete', {id: email.id}) }}"
   data-action-id="delete"
   data-priority="10"
   data-method="post"
   data-token="{{ csrf_token('delete_email_' ~ email.id) }}"
   data-confirm="{{ 'email.confirm_delete'|trans }}"
   aria-label="{{ 'email.delete'|trans }}"
   title="{{ 'email.delete'|trans }}">
    <i class="fa-solid fa-trash" aria-hidden="true"></i>
</a>
{% endif %}
