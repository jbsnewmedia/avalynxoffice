<div class="p-3">
    <p class="text-body-secondary small mb-2">{{ 'email.move_choose'|trans }}</p>
    <div class="list-group">
        {% for folder in folders %}
            {% set fid = folder.id ~ '' %}
            {% set isCurrent = fid in currentFolderIds %}
            {% if isCurrent %}
                <span class="list-group-item d-flex align-items-center disabled" aria-current="true">
                    <i class="fa-solid fa-folder me-2 text-body-secondary" aria-hidden="true"></i>
                    <span class="flex-grow-1 text-truncate">{{ folder.name }}</span>
                    <span class="badge bg-secondary-subtle text-body-secondary ms-2">{{ 'email.current_folder'|trans }}</span>
                </span>
            {% else %}
                <button type="button" class="list-group-item list-group-item-action d-flex align-items-center move-folder-choice"
                        data-email="{{ email.id }}"
                        data-folder-id="{{ fid }}"
                        data-folder-name="{{ folder.name }}"
                        data-token="{{ csrf_token('move_email') }}">
                    <i class="fa-solid fa-folder me-2 text-body-secondary" aria-hidden="true"></i>
                    <span class="flex-grow-1 text-truncate">{{ folder.name }}</span>
                </button>
            {% endif %}
        {% endfor %}
    </div>
</div>
