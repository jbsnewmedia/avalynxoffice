{% if license_manager.isReadOnly %}
    <span class="btn btn-primary disabled" data-priority="60" aria-disabled="true" title="{{ 'license.read_only_action'|trans }}">
        <i class="fa-solid fa-lock" aria-hidden="true"></i>
    </span>
{% else %}
<a class="btn btn-primary"
   href="#"
   data-action-id="move"
   data-priority="60"
   aria-label="{{ 'email.move'|trans }}"
   title="{{ 'email.move'|trans }}">
    <i class="fa-solid fa-folder" aria-hidden="true"></i>
</a>
{% endif %}
